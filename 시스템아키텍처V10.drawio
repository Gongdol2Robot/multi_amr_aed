        <mxCell id="recovered_L_v5_ws_lbl" parent="1" style="text;html=1;fontSize=24;fontStyle=1;fontColor=#17202A;align=left;verticalAlign=middle;" value="WebSocket /api/v1/ws?after_seq=uint64" vertex="1">
          <mxGeometry height="24" width="1000" x="1980.0" y="870.0" as="geometry" />
