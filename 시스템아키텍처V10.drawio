          <mxGeometry height="72" width="1090" x="8990" y="2590" as="geometry" />
        </mxCell>
        <mxCell id="v4_invariants" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FEF9E7;strokeColor=#B7950B;strokeWidth=1.5;fontSize=24;fontColor=#17202A;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;" value="필수 불변식&lt;br&gt;INV1 EXACT/RESPONDER active_delivery≤1; CONGESTED support는 DELIVERY가 아니다.&lt;br&gt;INV2 SEARCH active≤2, robot/zone unique, union=area, overlap=0, uncovered=0.&lt;br&gt;INV3 PATIENT_LOCATED 후 active_search=0과 zero barrier가 responder Goal보다 선행.&lt;br&gt;INV4 event_version·assignment_version·search_epoch 단조 증가; stale은 상태 변경 금지.&lt;br&gt;INV5 DB COMMIT 전 T01/T09/Action Goal 금지; outbox duplicate side effect 0.&lt;br&gt;INV6 caller_pose를 target으로 쓰려면 caller_with_patient=true.&lt;br&gt;INV7 timeout은 CLOCK_MONOTONIC, stamp는 UTC audit 전용.&lt;br&gt;위반 시: 모든 신규 Goal 금지→관련 Action cancel→Twist(0)→critical HMI+append-only audit." vertex="1">
          <mxGeometry height="550" width="1400" x="8680" y="2697.5" as="geometry" />
        </mxCell>
        <mxCell id="v4_enum_note" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FEF9E7;strokeColor=#B7950B;strokeWidth=1.5;fontSize=24;fontColor=#17202A;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;" value="events.status enum: IDLE0,VALIDATING1,PERSISTING2,EXACT_ASSIGN3,SEARCH_PLAN4,DELIVERY5,SEARCHING6,LOCKED7,ARRIVED8,HELPER9,WAIT10,REVIEW11,COMPLETED12,ESTOP13,CANCELED14. Lifecycle event_code E1..E16, ES=255." vertex="1">
          <mxGeometry height="132" width="1400" x="8680" y="3405" as="geometry" />
        </mxCell>
        <mxCell id="v4_error_note" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FEF9E7;strokeColor=#B7950B;strokeWidth=1.5;fontSize=24;fontColor=#17202A;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;" value="모든 실패·취소·경고의 reason은 5..500 UTF-8 chars, 빈 문자열 금지. 미사용 IDL 필드는 zero UUID/0/&quot;&quot;/pose.frame_id=&quot;&quot;. Subscriber idempotency=(event_id,event_version,event_code); receive_seq는 수신 노드 단조 증가 uint64." vertex="1">
