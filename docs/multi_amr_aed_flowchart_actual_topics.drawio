<mxfile host="app.diagrams.net" agent="codex-modeA-crowd-levels">
  <diagram name="메인 시스템 플로우 아키텍처 v4 · v2 구조 + 구현 계약" id="main-flow-v4-extended">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="11800" pageHeight="3300" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t1" parent="1" style="text;html=1;fontSize=14;fontStyle=1;fontColor=#1B2631;align=left;" value="&lt;b&gt;Mode A · 정확 위치 AED 출동 — Nav2 후보 경로 ETA 비교 · Camera2 혼잡 보정 · 단일 활성 + 재할당&lt;/b&gt;" vertex="1">
          <mxGeometry height="34" width="4540" x="40" y="10" as="geometry" />
        </mxCell>
        <mxCell id="leg" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FEF9E7;strokeColor=#B7950B;align=left;verticalAlign=top;fontSize=9;spacingLeft=5;spacingTop=3;fontColor=#7D6608;" value="통신 범례 ━ ROS 2 DDS ━ Action - - HTTP/WS ·· SQL&lt;br&gt;◆ 배너 = 물리 하드웨어 1대 · 빨간 세로띠 = 하드웨어 경계(넘는 화살표만 네트워크)&lt;br&gt;점선 박스 = 같은 머신 안의 프로세스. 각 박스:// I·O&lt;br&gt;육각형 = EVENT · 내부에 WHEN / DATA / VIA / FROM→TO 표시 · 전체 목록은 이 페이지 오른쪽" vertex="1">
          <mxGeometry height="90" width="880" x="40" y="46" as="geometry" />
        </mxCell>
        <mxCell id="leg2" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FEF9E7;strokeColor=#B7950B;align=left;verticalAlign=top;fontSize=9;spacingLeft=5;spacingTop=3;fontColor=#7D6608;" value="&lt;b&gt;Mode A 고정 규칙&lt;/b&gt;&lt;br&gt;· 정확 위치 target_pose로 robot1·robot2 ComputePathToPose 실행&lt;br&gt;· 항상 활성 출동 로봇은 1대, 나머지는 대기 후보&lt;br&gt;· Camera2가 발행한 CLEAR/CROWDED 판정을 중앙에서 시간 필터링&lt;br&gt;· 후보 final ETA 최소 로봇 배정 · ACK 3초 timeout · 실패 시 차순위 재할당" vertex="1">
          <mxGeometry height="86" width="900" x="940" y="46" as="geometry" />
        </mxCell>
