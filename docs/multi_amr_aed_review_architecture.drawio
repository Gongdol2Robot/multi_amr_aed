<mxfile host="app.diagrams.net" modified="2026-08-06T13:00:00.000Z" agent="Codex" version="24.7.17" type="device" compressed="false">
  <diagram id="end-to-end" name="00_End_to_End_External">
    <mxGraphModel dx="3200" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="7000" pageHeight="1650" math="0" shadow="0">
      <root><mxCell id="x0"/><mxCell id="x1" parent="x0"/>
        <mxCell id="xt" value="END-TO-END SYSTEM FLOW — External HW → ROS 2 → Backend → Frontend" style="text;html=1;fontSize=30;fontStyle=1;" vertex="1" parent="x1"><mxGeometry x="40" y="20" width="2500" height="50" as="geometry"/></mxCell>
        <mxCell id="xl" value="위쪽 ①~⑦ = 응급 감지와 출동 명령(Forward command flow)　|　가운데 ⑧~⑬ = 로봇/영상 상태 회수와 관제(Return telemetry flow)　|　아래 = 외부 네트워크·DB 경계. 번호 순서대로 읽습니다." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacing=12;fontSize=16;" vertex="1" parent="x1"><mxGeometry x="40" y="85" width="6600" height="60" as="geometry"/></mxCell>
        <mxCell id="lane1" value="FORWARD COMMAND FLOW" style="swimlane;html=1;rounded=1;startSize=38;horizontal=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=16;" vertex="1" parent="x1"><mxGeometry x="40" y="180" width="6600" height="390" as="geometry"/></mxCell>
        <mxCell id="xcamera" value="① EXTERNAL HW&lt;br&gt;&lt;b&gt;Fixed Webcam ×2&lt;/b&gt;&lt;br&gt;camera_open&lt;br&gt;camera_alley" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;" vertex="1" parent="x1"><mxGeometry x="90" y="285" width="330" height="130" as="geometry"/></mxCell>
        <mxCell id="xvision" value="② ROS PROCESS&lt;br&gt;&lt;b&gt;vision_detector ×2&lt;/b&gt;&lt;br&gt;OpenCV + YOLO&lt;br&gt;confirmation + homography" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="x1"><mxGeometry x="1000" y="285" width="350" height="130" as="geometry"/></mxCell>
        <mxCell id="xintake" value="③ EVENT INTAKE&lt;br&gt;&lt;b&gt;aggregate/intake node&lt;/b&gt;&lt;br&gt;camera + 119 입력 통합&lt;br&gt;&lt;span style=&quot;color:#b85450&quot;&gt;CURRENT missing&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;" vertex="1" parent="x1"><mxGeometry x="1910" y="285" width="350" height="130" as="geometry"/></mxCell>
        <mxCell id="xmanager" value="④ CENTRAL ROS NODE&lt;br&gt;&lt;b&gt;mission_manager&lt;/b&gt;&lt;br&gt;RobotState 후보 필터&lt;br&gt;cost rank + failover" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="x1"><mxGeometry x="2820" y="285" width="350" height="130" as="geometry"/></mxCell>
        <mxCell id="xexecutor" value="⑤ ROBOT ROS NODE ×2&lt;br&gt;&lt;b&gt;mission_executor&lt;/b&gt;&lt;br&gt;assignment validation&lt;br&gt;cancel + Nav2 goal" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="x1"><mxGeometry x="3730" y="285" width="350" height="130" as="geometry"/></mxCell>
        <mxCell id="xnav" value="⑥ ROBOT NAVIGATION ×2&lt;br&gt;&lt;b&gt;Nav2 stack&lt;/b&gt;&lt;br&gt;bt_navigator / planner&lt;br&gt;controller / localization" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="x1"><mxGeometry x="4640" y="285" width="350" height="130" as="geometry"/></mxCell>
        <mxCell id="xrobot" value="⑦ EXTERNAL HW ×2&lt;br&gt;&lt;b&gt;TurtleBot4 / Create3&lt;/b&gt;&lt;br&gt;motors + AED&lt;br&gt;LiDAR + OAK-D + battery" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;" vertex="1" parent="x1"><mxGeometry x="5550" y="285" width="370" height="130" as="geometry"/></mxCell>
        <mxCell id="xe1" value="&lt;b&gt;USB UVC / OpenCV VideoCapture&lt;/b&gt;&lt;br&gt;Data: BGR image frame uint8[H,W,3], configured 640×480 @ fps&lt;br&gt;Current direct_camera=true: ROS/DDS를 거치지 않고 process memory로 전달&lt;br&gt;Optional ROS mode: sensor_msgs/CompressedImage JPEG, BEST_EFFORT depth 1" style="edgeStyle=none;html=1;endArrow=block;strokeWidth=2;labelBackgroundColor=#ffffff;labelBorderColor=#9673a6;whiteSpace=wrap;labelWidth=420;align=left;fontSize=12;" edge="1" parent="x1" source="xcamera" target="xvision"><mxGeometry x="0" y="-125" width="420" height="120" relative="1" as="geometry"/></mxCell>
        <mxCell id="xe2" value="&lt;b&gt;ROS2 DDS Topic&lt;/b&gt;&lt;br&gt;/{camera_id}/vision/emergency_event&lt;br&gt;Type: aed_interfaces/msg/EmergencyEvent&lt;br&gt;Fields: event_id:string, time, PointStamped, confidence:f32, count:u32, status:u8, source/camera/zone:string, crowd:u8&lt;br&gt;CURRENT GAP: aggregate bridge 없음" style="edgeStyle=none;html=1;endArrow=block;strokeWidth=2;dashed=1;strokeColor=#b85450;labelBackgroundColor=#ffffff;labelBorderColor=#b85450;whiteSpace=wrap;labelWidth=440;align=left;fontSize=12;" edge="1" parent="x1" source="xvision" target="xintake"><mxGeometry x="0" y="-130" width="440" height="125" relative="1" as="geometry"/></mxCell>
        <mxCell id="xe3" value="&lt;b&gt;ROS2 DDS Topic&lt;/b&gt;&lt;br&gt;/aed/emergency_event&lt;br&gt;Type: aed_interfaces/msg/EmergencyEvent&lt;br&gt;QoS: RELIABLE, VOLATILE, depth 10&lt;br&gt;Condition: CONFIRMED + new event_id + map frame valid" style="edgeStyle=none;html=1;endArrow=block;strokeWidth=2;dashed=1;strokeColor=#b85450;labelBackgroundColor=#ffffff;labelBorderColor=#b85450;whiteSpace=wrap;labelWidth=430;align=left;fontSize=12;" edge="1" parent="x1" source="xintake" target="xmanager"><mxGeometry x="0" y="-110" width="430" height="105" relative="1" as="geometry"/></mxCell>
        <mxCell id="xe4" value="&lt;b&gt;CURRENT ROS2 DDS Topic&lt;/b&gt;&lt;br&gt;/{robot_id}/mission_assignment&lt;br&gt;Type: aed_interfaces/msg/MissionAssignment&lt;br&gt;Data: mission/event/robot IDs:string, role:u8, target:PoseStamped, assigned_at:Time, version:u32, cancel:bool&lt;br&gt;TARGET: DeliverAed.action Goal/Feedback/Result" style="edgeStyle=none;html=1;endArrow=block;strokeWidth=2;labelBackgroundColor=#ffffff;labelBorderColor=#6c8ebf;whiteSpace=wrap;labelWidth=440;align=left;fontSize=12;" edge="1" parent="x1" source="xmanager" target="xexecutor"><mxGeometry x="0" y="-125" width="440" height="120" relative="1" as="geometry"/></mxCell>
        <mxCell id="xe5" value="&lt;b&gt;ROS2 Action&lt;/b&gt;&lt;br&gt;/{robot_id}/navigate_to_pose&lt;br&gt;Type: nav2_msgs/action/NavigateToPose&lt;br&gt;Goal.pose: PoseStamped(map)&lt;br&gt;Result GoalStatus → ARRIVED/CANCELED/ERROR&lt;br&gt;Cancel: reassignment" style="edgeStyle=none;html=1;endArrow=block;startArrow=block;startFill=1;strokeWidth=2;labelBackgroundColor=#ffffff;labelBorderColor=#6c8ebf;whiteSpace=wrap;labelWidth=430;align=left;fontSize=12;" edge="1" parent="x1" source="xexecutor" target="xnav"><mxGeometry x="0" y="-115" width="430" height="110" relative="1" as="geometry"/></mxCell>
        <mxCell id="xe6" value="&lt;b&gt;Robot I/O over ROS2 DDS&lt;/b&gt;&lt;br&gt;Command: /{robot_id}/cmd_vel&lt;br&gt;Type: geometry_msgs/msg/Twist&lt;br&gt;linear.{x,y,z}:float64; angular.{x,y,z}:float64&lt;br&gt;Feedback inputs: nav_msgs/Odometry, sensor_msgs/LaserScan, BatteryState, dock status&lt;br&gt;Transport: robot Wi-Fi/Ethernet DDS" style="edgeStyle=none;html=1;endArrow=block;startArrow=block;startFill=1;strokeWidth=2;labelBackgroundColor=#ffffff;labelBorderColor=#9673a6;whiteSpace=wrap;labelWidth=520;align=left;fontSize=12;" edge="1" parent="x1" source="xnav" target="xrobot"><mxGeometry x="0" y="-130" width="520" height="125" relative="1" as="geometry"/></mxCell>

        <mxCell id="lane2" value="RETURN TELEMETRY + OPERATOR FLOW" style="swimlane;html=1;rounded=1;startSize=38;horizontal=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=16;" vertex="1" parent="x1"><mxGeometry x="40" y="610" width="6600" height="410" as="geometry"/></mxCell>
        <mxCell id="xrhw" value="⑧ ROBOT + CAMERA FEEDBACK&lt;br&gt;pose / battery / LiDAR&lt;br&gt;OAK-D JPEG / mission result" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;" vertex="1" parent="x1"><mxGeometry x="5550" y="740" width="370" height="120" as="geometry"/></mxCell>
        <mxCell id="xrmon" value="⑨ ROS AGGREGATORS&lt;br&gt;&lt;b&gt;robot_state_monitor ×2&lt;/b&gt;&lt;br&gt;mission_executor / vision&lt;br&gt;&lt;span style=&quot;color:#d79b00&quot;&gt;state monitor scaffold&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" vertex="1" parent="x1"><mxGeometry x="4640" y="740" width="360" height="120" as="geometry"/></mxCell>
        <mxCell id="xrbridge" value="⑩ BACKEND ROS BOUNDARY&lt;br&gt;&lt;b&gt;/aed_hmi_bridge&lt;/b&gt;&lt;br&gt;rclpy thread + converters&lt;br&gt;Context callbacks" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="x1"><mxGeometry x="3730" y="740" width="360" height="120" as="geometry"/></mxCell>
        <mxCell id="xrfast" value="⑪ HMI BACKEND PROCESS&lt;br&gt;&lt;b&gt;FastAPI + LiveState&lt;/b&gt;&lt;br&gt;Hub / FrameRegistry&lt;br&gt;Repository / SQLite" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="x1"><mxGeometry x="2820" y="740" width="360" height="120" as="geometry"/></mxCell>
        <mxCell id="xrfront" value="⑫ HMI FRONTEND&lt;br&gt;&lt;b&gt;React + TypeScript&lt;/b&gt;&lt;br&gt;LiveSocket / REST&lt;br&gt;VideoWall / MissionTable" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="x1"><mxGeometry x="1910" y="740" width="360" height="120" as="geometry"/></mxCell>
        <mxCell id="xroperator" value="⑬ EXTERNAL USER&lt;br&gt;&lt;b&gt;Operator Browser&lt;/b&gt;&lt;br&gt;Chrome/Edge&lt;br&gt;관제 화면" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;" vertex="1" parent="x1"><mxGeometry x="1000" y="740" width="370" height="120" as="geometry"/></mxCell>
        <mxCell id="xturn" value="&lt;b&gt;⑦ → ⑧ PHYSICAL RESULT / SENSOR FEEDBACK&lt;/b&gt;&lt;br&gt;모터 구동 결과와 센서 측정이 다시 ROS 상태 흐름으로 복귀&lt;br&gt;Internal device buses + robot ROS drivers&lt;br&gt;Data: encoder/pose, battery, LiDAR scan, OAK-D JPEG, Nav2 action result" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=3;labelBackgroundColor=#ffffff;labelBorderColor=#9673a6;whiteSpace=wrap;labelWidth=650;align=left;fontSize=12;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="x1" source="xrobot" target="xrhw"><mxGeometry x="0" y="0" width="650" height="105" relative="1" as="geometry"/></mxCell>
        <mxCell id="xre1" value="&lt;b&gt;ROS2 robot/camera inputs&lt;/b&gt;&lt;br&gt;Odometry: pose/twist + covariance&lt;br&gt;LaserScan: ranges:float32[], angles/range limits:float32&lt;br&gt;BatteryState: percentage:float32 etc.&lt;br&gt;CompressedImage: JPEG bytes&lt;br&gt;Mission result/status" style="edgeStyle=none;html=1;endArrow=block;strokeWidth=2;labelBackgroundColor=#ffffff;labelBorderColor=#9673a6;whiteSpace=wrap;labelWidth=470;align=left;fontSize=12;" edge="1" parent="x1" source="xrhw" target="xrmon"><mxGeometry x="0" y="-115" width="470" height="110" relative="1" as="geometry"/></mxCell>
        <mxCell id="xre2" value="&lt;b&gt;ROS2 DDS over LAN/Wi-Fi&lt;/b&gt;&lt;br&gt;/aed/robot_state : RobotState&lt;br&gt;/aed/mission_status : MissionStatus&lt;br&gt;/{camera}/vision/emergency_event : EmergencyEvent&lt;br&gt;person_count : UInt32; 4 image topics : CompressedImage&lt;br&gt;State QoS RELIABLE depth20 / Image BEST_EFFORT depth1" style="edgeStyle=none;html=1;endArrow=block;strokeWidth=2;labelBackgroundColor=#ffffff;labelBorderColor=#6c8ebf;whiteSpace=wrap;labelWidth=510;align=left;fontSize=12;" edge="1" parent="x1" source="xrmon" target="xrbridge"><mxGeometry x="0" y="-125" width="510" height="120" relative="1" as="geometry"/></mxCell>
        <mxCell id="xre3" value="&lt;b&gt;In-process Python callbacks&lt;/b&gt;&lt;br&gt;RobotSnapshot / EmergencyEventSnapshot / MissionEvent dataclasses&lt;br&gt;frame:bytes + stream_id:string&lt;br&gt;Thread boundary: rclpy SingleThreadedExecutor → Context&lt;br&gt;LiveState protected by threading.Lock" style="edgeStyle=none;html=1;endArrow=block;strokeWidth=2;labelBackgroundColor=#ffffff;labelBorderColor=#82b366;whiteSpace=wrap;labelWidth=500;align=left;fontSize=12;" edge="1" parent="x1" source="xrbridge" target="xrfast"><mxGeometry x="0" y="-115" width="500" height="110" relative="1" as="geometry"/></mxCell>
        <mxCell id="xre4" value="&lt;b&gt;TCP/IP Application Protocols&lt;/b&gt;&lt;br&gt;WebSocket ws://host:8000/ws/live → SystemSnapshot JSON, server push 4 Hz&lt;br&gt;HTTP REST GET /api/missions|stats|health → JSON&lt;br&gt;HTTP MJPEG GET /api/video/{stream_id} → multipart JPEG&lt;br&gt;Dev CORS origin: http://localhost:5173" style="edgeStyle=none;html=1;endArrow=block;strokeWidth=2;labelBackgroundColor=#ffffff;labelBorderColor=#82b366;whiteSpace=wrap;labelWidth=520;align=left;fontSize=12;" edge="1" parent="x1" source="xrfast" target="xrfront"><mxGeometry x="0" y="-125" width="520" height="120" relative="1" as="geometry"/></mxCell>
        <mxCell id="xre5" value="&lt;b&gt;External Browser Rendering / User I/O&lt;/b&gt;&lt;br&gt;Development: HTTP http://host:5173 (Vite)&lt;br&gt;Production target: same-origin HTTPS reverse proxy 권장&lt;br&gt;Input: mouse/keyboard browser events&lt;br&gt;Output: DOM/CSS dashboard, 4 MJPEG img elements, alarms/metrics" style="edgeStyle=none;html=1;endArrow=block;startArrow=block;startFill=1;strokeWidth=2;labelBackgroundColor=#ffffff;labelBorderColor=#9673a6;whiteSpace=wrap;labelWidth=500;align=left;fontSize=12;" edge="1" parent="x1" source="xrfront" target="xroperator"><mxGeometry x="0" y="-120" width="500" height="115" relative="1" as="geometry"/></mxCell>

        <mxCell id="lane3" value="EXTERNAL COMMUNICATION BOUNDARIES / PERSISTENCE" style="swimlane;html=1;rounded=1;startSize=38;horizontal=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=16;" vertex="1" parent="x1"><mxGeometry x="40" y="1060" width="6600" height="420" as="geometry"/></mxCell>
        <mxCell id="xnet" value="NETWORK BOUNDARY&lt;br&gt;&lt;b&gt;ROS 2 DDS / Fast DDS&lt;/b&gt;&lt;br&gt;Robot ↔ central PC ↔ camera PCs&lt;br&gt;Ethernet or Wi-Fi&lt;br&gt;same ROS_DOMAIN_ID&lt;br&gt;Discovery Server / ROS_SUPER_CLIENT" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="x1"><mxGeometry x="150" y="1180" width="600" height="170" as="geometry"/></mxCell>
        <mxCell id="xweb" value="WEB NETWORK BOUNDARY&lt;br&gt;&lt;b&gt;Browser ↔ FastAPI&lt;/b&gt;&lt;br&gt;TCP 8000: REST / WebSocket / MJPEG&lt;br&gt;TCP 5173: Vite dev server&lt;br&gt;CORS allowed origins configured&lt;br&gt;Production target: HTTPS/WSS + authentication + reverse proxy" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="x1"><mxGeometry x="1800" y="1180" width="650" height="170" as="geometry"/></mxCell>
        <mxCell id="xdb" value="LOCAL FILE I/O BOUNDARY&lt;br&gt;&lt;b&gt;FastAPI Repository ↔ SQLite&lt;/b&gt;&lt;br&gt;Path: var/aed_hmi.sqlite3&lt;br&gt;Protocol/API: Python sqlite3 / SQL transactions&lt;br&gt;PRAGMA WAL + foreign_keys ON&lt;br&gt;Types: TEXT, REAL(epoch seconds), INTEGER&lt;br&gt;Tables: events, assignments, transitions, robot samples, ETA records" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="x1"><mxGeometry x="3400" y="1170" width="700" height="190" as="geometry"/></mxCell>
        <mxCell id="xsecurity" value="DEPLOYMENT / SECURITY DECISIONS&lt;br&gt;&lt;b&gt;현재 개발망 전제&lt;/b&gt;&lt;br&gt;ROS DDS security 미설정&lt;br&gt;FastAPI authentication 미구현&lt;br&gt;CORS localhost만 허용&lt;br&gt;외부망 공개 금지&lt;br&gt;원격 접속 시 VPN/방화벽/HTTPS 정책을 별도 확정" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;" vertex="1" parent="x1"><mxGeometry x="5000" y="1170" width="750" height="190" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="function-loop" name="01_Function_Decision_Loops">
    <mxGraphModel dx="2200" dy="1400" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="3800" pageHeight="2800" math="0" shadow="0">
      <root><mxCell id="f0"/><mxCell id="f1" parent="f0"/>
        <mxCell id="ft" value="FUNCTION FLOW CHART — Detection, Dispatch, Recovery and Reassignment Loops" style="text;html=1;fontSize=30;fontStyle=1;" vertex="1" parent="f1"><mxGeometry x="40" y="20" width="2600" height="50" as="geometry"/></mxCell>
        <mxCell id="fl" value="마름모 안은 실제 코드의 판단 조건입니다. 초록=YES 정상 진행, 빨강=NO/실패, 주황=대기·재시도 루프. 화살표 라벨에는 판단에 사용되는 데이터와 ROS 인터페이스를 표시합니다." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacing=12;fontSize=15;" vertex="1" parent="f1"><mxGeometry x="40" y="85" width="3550" height="60" as="geometry"/></mxCell>
        <mxCell id="fstart" value="START&lt;br&gt;&lt;b&gt;Camera frame available&lt;/b&gt;&lt;br&gt;USB/OpenCV or CompressedImage" style="ellipse;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;" vertex="1" parent="f1"><mxGeometry x="1500" y="190" width="330" height="100" as="geometry"/></mxCell>
        <mxCell id="fdetect" value="VISION INFERENCE&lt;br&gt;&lt;b&gt;vision_detector._process_frame()&lt;/b&gt;&lt;br&gt;YOLO result = person / fallen / helper&lt;br&gt;homography pixel → map PointStamped" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="f1"><mxGeometry x="1450" y="370" width="430" height="125" as="geometry"/></mxCell>
        <mxCell id="dfallen" value="fallen 검출?&lt;br&gt;&lt;b&gt;bool(result.fallen)&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;fontStyle=1;" vertex="1" parent="f1"><mxGeometry x="1505" y="580" width="320" height="150" as="geometry"/></mxCell>
        <mxCell id="dconfirm" value="연속 검출 조건 충족?&lt;br&gt;&lt;b&gt;confirmation.update(...) == true&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;fontStyle=1;" vertex="1" parent="f1"><mxGeometry x="1480" y="830" width="370" height="170" as="geometry"/></mxCell>
        <mxCell id="fevent" value="EMERGENCY EVENT&lt;br&gt;&lt;b&gt;publish EmergencyEvent&lt;/b&gt;&lt;br&gt;event_id, detected_at, PointStamped(map), confidence,&lt;br&gt;consecutive_detections, status, source/camera/zone, crowd" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="f1"><mxGeometry x="1400" y="1090" width="530" height="140" as="geometry"/></mxCell>
        <mxCell id="devent" value="출동 가능한 이벤트?&lt;br&gt;&lt;b&gt;status==CONFIRMED&lt;/b&gt;&lt;br&gt;event_id new/nonempty&lt;br&gt;location.frame_id nonempty" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;fontStyle=1;" vertex="1" parent="f1"><mxGeometry x="1470" y="1320" width="390" height="190" as="geometry"/></mxCell>
        <mxCell id="frank" value="CANDIDATE RANKING&lt;br&gt;&lt;b&gt;mission_manager._assign_next()&lt;/b&gt;&lt;br&gt;RobotState filters: AVAILABLE, network/localization/nav2 OK,&lt;br&gt;!emergency_stop, valid pose; exclude failed robot&lt;br&gt;rank by path_cost when valid, otherwise geometric distance" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="f1"><mxGeometry x="1370" y="1600" width="590" height="155" as="geometry"/></mxCell>
        <mxCell id="dcandidate" value="가용 후보 있음?&lt;br&gt;&lt;b&gt;len(ranked) &gt; 0&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;fontStyle=1;" vertex="1" parent="f1"><mxGeometry x="1505" y="1845" width="320" height="155" as="geometry"/></mxCell>
        <mxCell id="fassign" value="ASSIGN SELECTED ROBOT&lt;br&gt;&lt;b&gt;assignment_version += 1&lt;/b&gt;&lt;br&gt;Current: MissionAssignment Topic&lt;br&gt;Target: DeliverAed Action Goal&lt;br&gt;cancel_previous=true" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="f1"><mxGeometry x="1405" y="2100" width="520" height="145" as="geometry"/></mxCell>
        <mxCell id="fexecute" value="EXECUTE NAV2&lt;br&gt;&lt;b&gt;mission_executor → NavigateToPose&lt;/b&gt;&lt;br&gt;DISPATCHING → EN_ROUTE&lt;br&gt;Action server wait 1.0 s; target frame validation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="f1"><mxGeometry x="1405" y="2330" width="520" height="125" as="geometry"/></mxCell>
        <mxCell id="dnav" value="Nav2 결과 성공?&lt;br&gt;&lt;b&gt;GoalStatus.SUCCEEDED&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;fontStyle=1;" vertex="1" parent="f1"><mxGeometry x="1505" y="2530" width="320" height="150" as="geometry"/></mxCell>
        <mxCell id="farrived" value="ARRIVED / TERMINAL&lt;br&gt;&lt;b&gt;MissionStatus.ARRIVED&lt;/b&gt;&lt;br&gt;mission_manager context.terminal=true&lt;br&gt;HMI/DB response time = arrived_at - called_at" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="f1"><mxGeometry x="720" y="2500" width="470" height="160" as="geometry"/></mxCell>
        <mxCell id="fwaitframe" value="WAIT NEXT FRAME&lt;br&gt;검출 counter reset/decay policy&lt;br&gt;다음 카메라 frame에서 다시 추론" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" vertex="1" parent="f1"><mxGeometry x="420" y="600" width="410" height="110" as="geometry"/></mxCell>
        <mxCell id="fignore" value="IGNORE / KEEP MONITORING&lt;br&gt;DETECTED 상태, duplicate event 또는 좌표 frame 오류&lt;br&gt;출동 context 생성하지 않음" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;" vertex="1" parent="f1"><mxGeometry x="500" y="1355" width="450" height="120" as="geometry"/></mxCell>
        <mxCell id="fwait" value="RECOVERY_WAIT&lt;br&gt;&lt;b&gt;MissionStatus.RECOVERY_WAIT&lt;/b&gt;&lt;br&gt;active_robot=None; waiting=true&lt;br&gt;reason='all robots temporarily unavailable'" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" vertex="1" parent="f1"><mxGeometry x="2450" y="1840" width="500" height="165" as="geometry"/></mxCell>
        <mxCell id="frecover" value="ROBOT STATE UPDATE&lt;br&gt;&lt;b&gt;_on_robot_state()&lt;/b&gt;&lt;br&gt;AVAILABLE + health restored&lt;br&gt;excluded.discard(robot_id)&lt;br&gt;publish RECOVERY_RESUMED after new assignment" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" vertex="1" parent="f1"><mxGeometry x="2450" y="2110" width="500" height="150" as="geometry"/></mxCell>
        <mxCell id="ffail" value="MISSION FAILURE&lt;br&gt;&lt;b&gt;BLOCKED | NETWORK_LOST | NAVIGATION_ERROR&lt;/b&gt;&lt;br&gt;또는 Action rejected/unavailable/canceled&lt;br&gt;failed robot → excluded set&lt;br&gt;active_robot=None" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;" vertex="1" parent="f1"><mxGeometry x="2450" y="2495" width="540" height="170" as="geometry"/></mxCell>
        <mxCell id="fobs" value="PARALLEL OBSERVABILITY (모든 단계에서 실행)&lt;br&gt;/aed_hmi_bridge subscribes EmergencyEvent + RobotState + MissionStatus + images → Context → LiveState/FrameRegistry/SQLite → WebSocket/REST/MJPEG → React HMI" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacing=12;fontSize=14;" vertex="1" parent="f1"><mxGeometry x="3080" y="370" width="560" height="210" as="geometry"/></mxCell>

        <mxCell id="fa1" value="frame: uint8 image / CompressedImage" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeWidth=2;" edge="1" parent="f1" source="fstart" target="fdetect"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="fa2" value="YOLO result.fallen: list" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeWidth=2;" edge="1" parent="f1" source="fdetect" target="dfallen"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="fa3" value="YES: fallen_count &gt; 0; confidence available" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#82b366;strokeWidth=2;" edge="1" parent="f1" source="dfallen" target="dconfirm"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="fa4" value="NO: fallen_count=0" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#b85450;strokeWidth=2;" edge="1" parent="f1" source="dfallen" target="fwaitframe"><mxGeometry relative="1" as="geometry"><mxPoint x="1050" y="655" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="fa5" value="next frame loop" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#d79b00;strokeWidth=2;exitX=0.5;exitY=0;entryX=0;entryY=0.5;" edge="1" parent="f1" source="fwaitframe" target="fdetect"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1030" y="655"/><mxPoint x="1030" y="432"/></Array></mxGeometry></mxCell>
        <mxCell id="fa6" value="YES: consecutive_detections ≥ configured threshold" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#82b366;strokeWidth=2;" edge="1" parent="f1" source="dconfirm" target="fevent"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="fa7" value="NO: counter not yet sufficient → next frame" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#d79b00;strokeWidth=2;" edge="1" parent="f1" source="dconfirm" target="fwaitframe"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1120" y="915"/><mxPoint x="1120" y="655"/></Array></mxGeometry></mxCell>
        <mxCell id="fa8" value="/aed/emergency_event : EmergencyEvent (target aggregate)&lt;br&gt;status:uint8, location:PointStamped, event_id:string" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeWidth=2;labelBackgroundColor=#ffffff;labelBorderColor=#6c8ebf;whiteSpace=wrap;" edge="1" parent="f1" source="fevent" target="devent"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="fa9" value="YES: valid CONFIRMED event" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#82b366;strokeWidth=2;" edge="1" parent="f1" source="devent" target="frank"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="fa10" value="NO: DETECTED/duplicate/invalid frame" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#b85450;strokeWidth=2;" edge="1" parent="f1" source="devent" target="fignore"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="fa11" value="RobotState[] → ranked robot_id[]" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeWidth=2;" edge="1" parent="f1" source="frank" target="dcandidate"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="fa12" value="YES: ranked[0] selected" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#82b366;strokeWidth=2;" edge="1" parent="f1" source="dcandidate" target="fassign"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="fa13" value="NO: empty candidates" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#d79b00;strokeWidth=2;" edge="1" parent="f1" source="dcandidate" target="fwait"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="fa14" value="wait for /aed/robot_state&lt;br&gt;Type: RobotState; health flags + availability" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#d79b00;strokeWidth=2;labelBackgroundColor=#ffffff;labelBorderColor=#d6b656;whiteSpace=wrap;" edge="1" parent="f1" source="fwait" target="frecover"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="fa15" value="RECOVERY LOOP: available robot → evaluate candidates again" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#d79b00;strokeWidth=3;exitX=1;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="f1" source="frecover" target="frank"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="3250" y="2185"/><mxPoint x="3250" y="1677"/></Array></mxGeometry></mxCell>
        <mxCell id="fa16" value="MissionAssignment msg OR DeliverAed Goal&lt;br&gt;IDs:string; target:PoseStamped; role:u8; version:u32" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeWidth=2;labelBackgroundColor=#ffffff;labelBorderColor=#82b366;whiteSpace=wrap;" edge="1" parent="f1" source="fassign" target="fexecute"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="fa17" value="NavigateToPose result: GoalStatus" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeWidth=2;" edge="1" parent="f1" source="fexecute" target="dnav"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="fa18" value="YES: STATUS_SUCCEEDED" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#82b366;strokeWidth=2;" edge="1" parent="f1" source="dnav" target="farrived"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="fa19" value="NO: canceled/rejected/unavailable/error" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#b85450;strokeWidth=2;" edge="1" parent="f1" source="dnav" target="ffail"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="fa20" value="REALLOCATION LOOP: MissionStatus failure&lt;br&gt;event_id + robot_id + version match → exclude failed robot" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#b85450;strokeWidth=3;exitX=1;exitY=0.5;entryX=1;entryY=0.5;labelBackgroundColor=#ffffff;labelBorderColor=#b85450;whiteSpace=wrap;" edge="1" parent="f1" source="ffail" target="frank"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="3490" y="2580"/><mxPoint x="3490" y="1677"/></Array></mxGeometry></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="current" name="02_CURRENT_ROS_Flow">
    <mxGraphModel dx="2200" dy="1400" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="3000" pageHeight="3000" math="0" shadow="0">
      <root><mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="title" value="CURRENT ROS 2 FLOW — One Communication per Row / Arrow Label = Full Contract" style="text;html=1;fontSize=28;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="2100" height="45" as="geometry"/></mxCell>
        <mxCell id="legend" value="읽는 법: 왼쪽 Publisher → 오른쪽 Subscriber. 각 행은 완전히 독립되어 선 교차·분기 없음. 파랑=구현됨, 빨강=연결 누락, 노랑=scaffold/미구현 producer." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacing=12;fontSize=15;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="2860" height="55" as="geometry"/></mxCell>
        <mxCell id="lh" value="PUBLISHER" style="text;html=1;fontSize=18;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="150" width="320" height="35" as="geometry"/></mxCell><mxCell id="mh" value="화살표 라벨: 이름 / 방식 / Type / Data / QoS / Trigger" style="text;html=1;fontSize=18;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="420" y="150" width="1980" height="35" as="geometry"/></mxCell><mxCell id="rh" value="SUBSCRIBER + CALLBACK" style="text;html=1;fontSize=18;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="2480" y="150" width="420" height="35" as="geometry"/></mxCell>

        <mxCell id="p1" value="/{camera_id}/vision_detector&lt;br&gt;&lt;b&gt;_publish_emergency_event()&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="240" width="320" height="90" as="geometry"/></mxCell>
        <mxCell id="s1" value="/aed_hmi_bridge&lt;br&gt;&lt;b&gt;_handle_emergency_event()&lt;/b&gt;&lt;br&gt;→ Context.on_event()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="1"><mxGeometry x="2480" y="230" width="420" height="110" as="geometry"/></mxCell>
        <mxCell id="e1" value="&lt;b&gt;/{camera_id}/vision/emergency_event　[TOPIC]&lt;/b&gt;&lt;br&gt;Type = aed_interfaces/msg/EmergencyEvent&lt;br&gt;Data = event_id:string; detected_at:builtin_interfaces/Time; location:geometry_msgs/PointStamped; confidence:float32; consecutive_detections:uint32; status:uint8; source_id:string; camera_id:string; zone_id:string; crowd_level:uint8&lt;br&gt;QoS = RELIABLE + VOLATILE + KEEP_LAST depth 10　|　Trigger = fallen 연속 검출 confirmation 및 이벤트 상태 변경" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;labelBackgroundColor=#ffffff;labelBorderColor=#6c8ebf;whiteSpace=wrap;labelWidth=1900;align=left;spacing=8;fontSize=13;" edge="1" parent="1" source="p1" target="s1"><mxGeometry x="0" y="-95" width="1900" height="125" relative="1" as="geometry"/></mxCell>

        <mxCell id="p2" value="/{camera_id}/vision_detector&lt;br&gt;&lt;b&gt;_process_frame()&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="475" width="320" height="85" as="geometry"/></mxCell>
        <mxCell id="s2" value="/aed_hmi_bridge&lt;br&gt;&lt;b&gt;on_person_count lambda&lt;/b&gt;&lt;br&gt;→ LiveState._detections" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="1"><mxGeometry x="2480" y="465" width="420" height="105" as="geometry"/></mxCell>
        <mxCell id="e2" value="&lt;b&gt;/{camera_id}/vision/person_count　[TOPIC]&lt;/b&gt;&lt;br&gt;Type = std_msgs/msg/UInt32　|　Data = data:uint32 (현재 프레임 person class 검출 개수)&lt;br&gt;QoS = RELIABLE + VOLATILE + KEEP_LAST depth 10　|　Trigger = 처리한 매 프레임　|　HMI rule = camera_id→stream_id, 3초 이상 갱신 없으면 0" style="edgeStyle=none;html=1;endArrow=block;strokeWidth=2;labelBackgroundColor=#ffffff;labelBorderColor=#6c8ebf;whiteSpace=wrap;labelWidth=1900;align=left;spacing=8;fontSize=13;" edge="1" parent="1" source="p2" target="s2"><mxGeometry x="0" y="-70" width="1900" height="95" relative="1" as="geometry"/></mxCell>

        <mxCell id="p3" value="vision_detector ×2&lt;br&gt;OAK-D driver ×2&lt;br&gt;&lt;b&gt;JPEG publishers&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="690" width="320" height="95" as="geometry"/></mxCell>
        <mxCell id="s3" value="/aed_hmi_bridge ×4&lt;br&gt;&lt;b&gt;on_frame lambda&lt;/b&gt;&lt;br&gt;→ FrameRegistry" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="1"><mxGeometry x="2480" y="685" width="420" height="105" as="geometry"/></mxCell>
        <mxCell id="e3" value="&lt;b&gt;4 VIDEO TOPICS　[TOPIC]&lt;/b&gt;&lt;br&gt;Names = /camera_open/vision/debug/compressed; /camera_alley/vision/debug/compressed; /robot1/oakd/rgb/image_raw/compressed; /robot2/oakd/rgb/image_raw/compressed&lt;br&gt;Type = sensor_msgs/msg/CompressedImage　|　Data = header.stamp:Time; header.frame_id:string; format:string('jpeg'); data:uint8[]&lt;br&gt;QoS = BEST_EFFORT + VOLATILE + KEEP_LAST depth 1　|　Trigger = frame ready; backlog 없이 최신 JPEG만 유지" style="edgeStyle=none;html=1;endArrow=block;strokeWidth=2;labelBackgroundColor=#ffffff;labelBorderColor=#6c8ebf;whiteSpace=wrap;labelWidth=1900;align=left;spacing=8;fontSize=13;" edge="1" parent="1" source="p3" target="s3"><mxGeometry x="0" y="-90" width="1900" height="120" relative="1" as="geometry"/></mxCell>

        <mxCell id="p4" value="/{camera_id}/vision_detector&lt;br&gt;&lt;b&gt;1.0 s timer&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="920" width="320" height="85" as="geometry"/></mxCell>
        <mxCell id="s4" value="현재 Subscriber 없음&lt;br&gt;/recovery_manager scaffold" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" vertex="1" parent="1"><mxGeometry x="2480" y="920" width="420" height="85" as="geometry"/></mxCell>
        <mxCell id="e4" value="&lt;b&gt;/{camera_id}/vision/heartbeat　[TOPIC — CURRENTLY UNCONNECTED]&lt;/b&gt;&lt;br&gt;Type = aed_interfaces/msg/Heartbeat　|　Data = sender_id:string('aed_vision:{camera_id}'); stamp:Time; sequence:uint32 monotonic&lt;br&gt;QoS = RELIABLE + VOLATILE + KEEP_LAST depth 10　|　Trigger = 1.0 s periodic, 영상 입력 유무와 무관" style="edgeStyle=none;html=1;endArrow=block;strokeWidth=2;dashed=1;strokeColor=#d79b00;labelBackgroundColor=#ffffff;labelBorderColor=#d6b656;whiteSpace=wrap;labelWidth=1900;align=left;spacing=8;fontSize=13;" edge="1" parent="1" source="p4" target="s4"><mxGeometry x="0" y="-70" width="1900" height="95" relative="1" as="geometry"/></mxCell>

        <mxCell id="p5" value="/robot_state_monitor ×2&lt;br&gt;&lt;b&gt;CURRENT scaffold&lt;/b&gt;&lt;br&gt;publisher 미구현" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="1150" width="320" height="105" as="geometry"/></mxCell>
        <mxCell id="s5" value="/mission_manager&lt;br&gt;&lt;b&gt;_on_robot_state()&lt;/b&gt;&lt;br&gt;→ eligibility + rank cache" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="1"><mxGeometry x="2480" y="1150" width="420" height="105" as="geometry"/></mxCell>
        <mxCell id="e5" value="&lt;b&gt;/aed/robot_state　[TOPIC]&lt;/b&gt;&lt;br&gt;Type = aed_interfaces/msg/RobotState&lt;br&gt;Data = robot_id:string; stamp:Time; pose:PoseStamped; speed_mps:float32; battery_percentage:float32; availability:uint8; role:uint8; mission_id:string; is_docked:bool; network_ok/localization_ok/nav2_ok/emergency_stop/path_valid:bool; estimated_path_cost:float32; last_heartbeat:Time; detail:string&lt;br&gt;QoS SUB = RELIABLE + VOLATILE + KEEP_LAST depth 20　|　Use = AVAILABLE 및 health flags 필터 후 path_cost/거리 후보 순위" style="edgeStyle=none;html=1;endArrow=block;strokeWidth=2;dashed=1;strokeColor=#d79b00;labelBackgroundColor=#ffffff;labelBorderColor=#d6b656;whiteSpace=wrap;labelWidth=1900;align=left;spacing=8;fontSize=13;" edge="1" parent="1" source="p5" target="s5"><mxGeometry x="0" y="-95" width="1900" height="130" relative="1" as="geometry"/></mxCell>

        <mxCell id="p6" value="/robot_state_monitor ×2&lt;br&gt;&lt;b&gt;동일 Topic publisher&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="1400" width="320" height="90" as="geometry"/></mxCell>
        <mxCell id="s6" value="/aed_hmi_bridge&lt;br&gt;&lt;b&gt;_handle_robot_state()&lt;/b&gt;&lt;br&gt;→ RobotSnapshot / LiveState / DB" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="1"><mxGeometry x="2480" y="1390" width="420" height="110" as="geometry"/></mxCell>
        <mxCell id="e6" value="&lt;b&gt;/aed/robot_state　[TOPIC — SECOND SUBSCRIBER, SEPARATE ROW]&lt;/b&gt;&lt;br&gt;Type/Data = aed_interfaces/msg/RobotState (상단 행과 동일)&lt;br&gt;QoS SUB = RELIABLE + VOLATILE + KEEP_LAST depth 20　|　Convert = ROS uint8 Enum→문자열 Enum; quaternion→yaw_deg; pose 차분→speed_mps; heartbeat age 계산&lt;br&gt;Store = LiveState latest per robot + SQLite robot_samples 1 Hz sampling" style="edgeStyle=none;html=1;endArrow=block;strokeWidth=2;dashed=1;strokeColor=#d79b00;labelBackgroundColor=#ffffff;labelBorderColor=#d6b656;whiteSpace=wrap;labelWidth=1900;align=left;spacing=8;fontSize=13;" edge="1" parent="1" source="p6" target="s6"><mxGeometry x="0" y="-85" width="1900" height="115" relative="1" as="geometry"/></mxCell>

        <mxCell id="p7" value="Aggregate event publisher&lt;br&gt;&lt;b&gt;CURRENT MISSING&lt;/b&gt;&lt;br&gt;camera topic bridge 필요" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="1640" width="320" height="105" as="geometry"/></mxCell>
        <mxCell id="s7" value="/mission_manager&lt;br&gt;&lt;b&gt;_on_emergency()&lt;/b&gt;&lt;br&gt;→ event context → assign" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="1"><mxGeometry x="2480" y="1640" width="420" height="105" as="geometry"/></mxCell>
        <mxCell id="e7" value="&lt;b&gt;/aed/emergency_event　[TOPIC — REQUIRED BUT NO CURRENT PUBLISHER]&lt;/b&gt;&lt;br&gt;Type/Data = aed_interfaces/msg/EmergencyEvent (첫 행과 동일 전체 필드)&lt;br&gt;QoS SUB = RELIABLE + VOLATILE + KEEP_LAST depth 10　|　Accept condition = status==CONFIRMED; event_id nonempty/new; location.header.frame_id nonempty&lt;br&gt;GAP = vision_detector는 /{camera_id}/vision/emergency_event만 발행하므로 mission_manager 출동으로 연결되지 않음" style="edgeStyle=none;html=1;endArrow=block;strokeWidth=2;dashed=1;strokeColor=#b85450;labelBackgroundColor=#ffffff;labelBorderColor=#b85450;whiteSpace=wrap;labelWidth=1900;align=left;spacing=8;fontSize=13;" edge="1" parent="1" source="p7" target="s7"><mxGeometry x="0" y="-90" width="1900" height="120" relative="1" as="geometry"/></mxCell>

        <mxCell id="p8" value="/mission_manager&lt;br&gt;&lt;b&gt;_assign_next()&lt;/b&gt;&lt;br&gt;selected robot publisher" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="1885" width="320" height="105" as="geometry"/></mxCell>
        <mxCell id="s8" value="/{robot_id}/mission_executor&lt;br&gt;&lt;b&gt;_on_assignment()&lt;/b&gt;&lt;br&gt;→ cancel old / send Nav2 goal" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="1"><mxGeometry x="2480" y="1885" width="420" height="105" as="geometry"/></mxCell>
        <mxCell id="e8" value="&lt;b&gt;/{robot_id}/mission_assignment　[TOPIC]&lt;/b&gt;&lt;br&gt;Type = aed_interfaces/msg/MissionAssignment&lt;br&gt;Data = mission_id:string('{event_id}-aed'); event_id:string; robot_id:string; role:uint8(ROLE_AED_DELIVERY); target:PoseStamped(map); assigned_at:Time; assignment_version:uint32 increment; cancel_previous:bool=true&lt;br&gt;QoS = RELIABLE + VOLATILE + KEEP_LAST depth 10　|　Trigger = candidate selected/recovered; chosen robot topic 하나에만 발행" style="edgeStyle=none;html=1;endArrow=block;strokeWidth=2;labelBackgroundColor=#ffffff;labelBorderColor=#6c8ebf;whiteSpace=wrap;labelWidth=1900;align=left;spacing=8;fontSize=13;" edge="1" parent="1" source="p8" target="s8"><mxGeometry x="0" y="-95" width="1900" height="125" relative="1" as="geometry"/></mxCell>

        <mxCell id="p9" value="/{robot_id}/mission_executor&lt;br&gt;&lt;b&gt;ActionClient&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="2130" width="320" height="85" as="geometry"/></mxCell>
        <mxCell id="s9" value="/{robot_id}/bt_navigator&lt;br&gt;&lt;b&gt;NavigateToPose ActionServer&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;" vertex="1" parent="1"><mxGeometry x="2480" y="2125" width="420" height="95" as="geometry"/></mxCell>
        <mxCell id="e9" value="&lt;b&gt;/{robot_id}/navigate_to_pose　[ACTION]&lt;/b&gt;&lt;br&gt;Type = nav2_msgs/action/NavigateToPose　|　Goal = pose:geometry_msgs/PoseStamped (stamp=now)&lt;br&gt;Result = GoalStatus; SUCCEEDED→MissionStatus.ARRIVED, CANCELED→CANCELED, 기타→NAVIGATION_ERROR　|　Feedback = 현재 코드 미사용&lt;br&gt;Precondition = target.frame_id nonempty; server wait timeout 1.0 s　|　Cancel = 새 assignment에서 cancel_previous=true" style="edgeStyle=none;html=1;endArrow=block;startArrow=block;startFill=1;strokeWidth=2;labelBackgroundColor=#ffffff;labelBorderColor=#6c8ebf;whiteSpace=wrap;labelWidth=1900;align=left;spacing=8;fontSize=13;" edge="1" parent="1" source="p9" target="s9"><mxGeometry x="0" y="-85" width="1900" height="115" relative="1" as="geometry"/></mxCell>

        <mxCell id="p10" value="mission_executor ×2&lt;br&gt;mission_manager&lt;br&gt;&lt;b&gt;state publishers&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="2365" width="320" height="95" as="geometry"/></mxCell>
        <mxCell id="s10" value="/mission_manager&lt;br&gt;&lt;b&gt;_on_mission_status()&lt;/b&gt;&lt;br&gt;→ terminal / failover" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="1"><mxGeometry x="2480" y="2360" width="420" height="105" as="geometry"/></mxCell>
        <mxCell id="e10" value="&lt;b&gt;/aed/mission_status　[TOPIC]&lt;/b&gt;&lt;br&gt;Type = aed_interfaces/msg/MissionStatus&lt;br&gt;Data = mission_id:string; event_id:string; robot_id:string; assignment_version:uint32; status:uint8 {0..13: ASSIGNED, DISPATCHING, EN_ROUTE, ARRIVED, COMPLETED, CANCELED, BLOCKED, NETWORK_LOST, NAVIGATION_ERROR, RECOVERY_WAIT, RECOVERY_RESUMED, HELPER_*}; stamp:Time; reason:string&lt;br&gt;QoS SUB = RELIABLE + VOLATILE + KEEP_LAST depth 20　|　Match = event_id + active_robot + assignment_version; failure→exclude/reassign; arrived/completed→terminal" style="edgeStyle=none;html=1;endArrow=block;strokeWidth=2;labelBackgroundColor=#ffffff;labelBorderColor=#6c8ebf;whiteSpace=wrap;labelWidth=1900;align=left;spacing=8;fontSize=13;" edge="1" parent="1" source="p10" target="s10"><mxGeometry x="0" y="-100" width="1900" height="135" relative="1" as="geometry"/></mxCell>

        <mxCell id="p11" value="mission_executor ×2&lt;br&gt;mission_manager&lt;br&gt;&lt;b&gt;동일 Topic publishers&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="2620" width="320" height="95" as="geometry"/></mxCell>
        <mxCell id="s11" value="/aed_hmi_bridge&lt;br&gt;&lt;b&gt;_handle_mission_status()&lt;/b&gt;&lt;br&gt;→ LiveState + SQLite append" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="1"><mxGeometry x="2480" y="2615" width="420" height="105" as="geometry"/></mxCell>
        <mxCell id="e11" value="&lt;b&gt;/aed/mission_status　[TOPIC — SECOND SUBSCRIBER, SEPARATE ROW]&lt;/b&gt;&lt;br&gt;Type/Data = aed_interfaces/msg/MissionStatus (상단 행과 동일 전체 필드)&lt;br&gt;QoS SUB = RELIABLE + VOLATILE + KEEP_LAST depth 20　|　Convert = status:uint8→MissionState 문자열 enum&lt;br&gt;Use = LiveState latest transition per mission; Repository mission_events에 상태 전이를 UPDATE 없이 append; WebSocket active_missions 및 REST timeline 생성" style="edgeStyle=none;html=1;endArrow=block;strokeWidth=2;labelBackgroundColor=#ffffff;labelBorderColor=#6c8ebf;whiteSpace=wrap;labelWidth=1900;align=left;spacing=8;fontSize=13;" edge="1" parent="1" source="p11" target="s11"><mxGeometry x="0" y="-85" width="1900" height="115" relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="target" name="03_TARGET_ROS_Flow">
    <mxGraphModel dx="2200" dy="1400" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="3000" pageHeight="2600" math="0" shadow="0">
      <root><mxCell id="t0"/><mxCell id="t1" parent="t0"/>
        <mxCell id="tt" value="TARGET ROS 2 FLOW — Final Interface Contract for Implementation" style="text;html=1;fontSize=28;fontStyle=1;" vertex="1" parent="t1"><mxGeometry x="40" y="20" width="2000" height="45" as="geometry"/></mxCell>
        <mxCell id="tl" value="모든 선은 독립 수평선이며, 화살표 라벨에 코드 작성에 필요한 Goal/Result/Feedback 또는 Request/Response와 자료형을 직접 표시." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacing=12;fontSize=15;" vertex="1" parent="t1"><mxGeometry x="40" y="80" width="2860" height="55" as="geometry"/></mxCell>
        <mxCell id="tp1" value="119 / Operator HMI&lt;br&gt;&lt;b&gt;Service Client&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" vertex="1" parent="t1"><mxGeometry x="40" y="230" width="320" height="90" as="geometry"/></mxCell><mxCell id="ts1" value="/emergency_intake&lt;br&gt;&lt;b&gt;Service Server&lt;/b&gt;&lt;br&gt;현재 미구현" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" vertex="1" parent="t1"><mxGeometry x="2480" y="220" width="420" height="110" as="geometry"/></mxCell>
        <mxCell id="te1" value="&lt;b&gt;/aed/report_emergency　[SERVICE]&lt;/b&gt;&lt;br&gt;Type = aed_interfaces/srv/ReportEmergency&lt;br&gt;Request = location:geometry_msgs/PointStamped; source_id:string; zone_id:string; confidence:float32&lt;br&gt;Response = accepted:bool; event_id:string; reason:string　|　Semantic = 즉시 접수·유효성·중복 판정만 수행; 주행 완료까지 blocking 금지" style="edgeStyle=none;html=1;endArrow=block;startArrow=block;startFill=1;strokeWidth=2;dashed=1;strokeColor=#d79b00;labelBackgroundColor=#ffffff;labelBorderColor=#d6b656;whiteSpace=wrap;labelWidth=1900;align=left;spacing=8;fontSize=13;" edge="1" parent="t1" source="tp1" target="ts1"><mxGeometry x="0" y="-85" width="1900" height="115" relative="1" as="geometry"/></mxCell>

        <mxCell id="tp2" value="/{camera_id}/vision_detector&lt;br&gt;&lt;b&gt;YOLO + homography&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" vertex="1" parent="t1"><mxGeometry x="40" y="485" width="320" height="90" as="geometry"/></mxCell><mxCell id="ts2" value="aed_hmi_bridge / emergency_intake&lt;br&gt;helper_mission_controller&lt;br&gt;&lt;b&gt;Detection subscribers&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" vertex="1" parent="t1"><mxGeometry x="2480" y="475" width="420" height="110" as="geometry"/></mxCell>
        <mxCell id="te2" value="&lt;b&gt;/{camera_id}/vision/detections　[TOPIC]&lt;/b&gt;&lt;br&gt;Type = aed_interfaces/msg/DetectionSummary&lt;br&gt;Data = camera_id:string; stamp:Time; person_count:uint32; fallen_count:uint32; helper_count:uint32; top_fallen_confidence:float32; top_helper_confidence:float32; fallen_location:PointStamped&lt;br&gt;Validity = 좌표변환 실패 시 fallen_location.header.frame_id=''　|　QoS target = BEST_EFFORT + VOLATILE + KEEP_LAST depth 1　|　Trigger = processed frame" style="edgeStyle=none;html=1;endArrow=block;strokeWidth=2;dashed=1;strokeColor=#d79b00;labelBackgroundColor=#ffffff;labelBorderColor=#d6b656;whiteSpace=wrap;labelWidth=1900;align=left;spacing=8;fontSize=13;" edge="1" parent="t1" source="tp2" target="ts2"><mxGeometry x="0" y="-95" width="1900" height="125" relative="1" as="geometry"/></mxCell>

        <mxCell id="tp3" value="/{camera_id}/vision_detector&lt;br&gt;&lt;b&gt;crowd evaluator&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" vertex="1" parent="t1"><mxGeometry x="40" y="740" width="320" height="90" as="geometry"/></mxCell><mxCell id="ts3" value="emergency_intake / mission_manager&lt;br&gt;aed_hmi_bridge&lt;br&gt;&lt;b&gt;Crowd subscribers&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" vertex="1" parent="t1"><mxGeometry x="2480" y="730" width="420" height="110" as="geometry"/></mxCell>
        <mxCell id="te3" value="&lt;b&gt;/{camera_id}/vision/crowd_level　[TOPIC]&lt;/b&gt;&lt;br&gt;Type = aed_interfaces/msg/CrowdLevel&lt;br&gt;Data = camera_id:string; zone_id:string; stamp:Time; level:uint8 {CLEAR=0, MODERATE=1, CONGESTED=2}; person_count:uint32; threshold:uint32; roi_occupancy:float32[0..1]&lt;br&gt;Semantic = 등급과 판단 근거를 같은 sample에 전달; event 확정 시 EmergencyEvent.crowd_level로 복사　|　QoS target = RELIABLE + VOLATILE + KEEP_LAST depth 10" style="edgeStyle=none;html=1;endArrow=block;strokeWidth=2;dashed=1;strokeColor=#d79b00;labelBackgroundColor=#ffffff;labelBorderColor=#d6b656;whiteSpace=wrap;labelWidth=1900;align=left;spacing=8;fontSize=13;" edge="1" parent="t1" source="tp3" target="ts3"><mxGeometry x="0" y="-95" width="1900" height="125" relative="1" as="geometry"/></mxCell>

        <mxCell id="tp4" value="/robot_state_monitor ×2&lt;br&gt;&lt;b&gt;state aggregator&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" vertex="1" parent="t1"><mxGeometry x="40" y="995" width="320" height="90" as="geometry"/></mxCell><mxCell id="ts4" value="mission_manager / aed_hmi_bridge&lt;br&gt;event_logger&lt;br&gt;&lt;b&gt;State subscribers&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" vertex="1" parent="t1"><mxGeometry x="2480" y="985" width="420" height="110" as="geometry"/></mxCell>
        <mxCell id="te4" value="&lt;b&gt;/aed/robot_state　[TOPIC]&lt;/b&gt;&lt;br&gt;Type = aed_interfaces/msg/RobotState&lt;br&gt;Data = robot_id:string; stamp:Time; pose:PoseStamped(map); speed_mps/battery_percentage/estimated_path_cost:float32; availability/role:uint8; mission_id:string; is_docked/network_ok/localization_ok/nav2_ok/emergency_stop/path_valid:bool; last_heartbeat:Time; detail:string&lt;br&gt;QoS target = RELIABLE + VOLATILE + KEEP_LAST depth 20; publish target 5 Hz; HMI stale timeout 6 s" style="edgeStyle=none;html=1;endArrow=block;strokeWidth=2;dashed=1;strokeColor=#d79b00;labelBackgroundColor=#ffffff;labelBorderColor=#d6b656;whiteSpace=wrap;labelWidth=1900;align=left;spacing=8;fontSize=13;" edge="1" parent="t1" source="tp4" target="ts4"><mxGeometry x="0" y="-100" width="1900" height="135" relative="1" as="geometry"/></mxCell>

        <mxCell id="tp5" value="/mission_manager&lt;br&gt;&lt;b&gt;DeliverAed ActionClient ×2&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" vertex="1" parent="t1"><mxGeometry x="40" y="1260" width="320" height="90" as="geometry"/></mxCell><mxCell id="ts5" value="/{robot_id}/mission_executor&lt;br&gt;&lt;b&gt;DeliverAed ActionServer&lt;/b&gt;&lt;br&gt;internally Nav2 client" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" vertex="1" parent="t1"><mxGeometry x="2480" y="1245" width="420" height="120" as="geometry"/></mxCell>
        <mxCell id="te5" value="&lt;b&gt;/{robot_id}/deliver_aed　[ACTION]&lt;/b&gt;&lt;br&gt;Type = aed_interfaces/action/DeliverAed&lt;br&gt;Goal = mission_id:string; event_id:string; role:uint8; target:PoseStamped; crowd_level:uint8; requested_at:Time&lt;br&gt;Feedback = state:uint8; current_pose:PoseStamped; speed_mps:float32; distance_remaining_m:float32; eta_seconds:float32(negative=unknown)&lt;br&gt;Result = outcome:uint8 {SUCCESS, ABORTED_NAVIGATION, ABORTED_NETWORK, ABORTED_SENSOR, CANCELED}; started_at/finished_at:Time; travelled_m:float32; final_pose:PoseStamped; detail:string&lt;br&gt;Reassignment = cancel current goal then new robot goal; active goal uniqueness keyed by event_id/mission_id" style="edgeStyle=none;html=1;endArrow=block;startArrow=block;startFill=1;strokeWidth=2;dashed=1;strokeColor=#d79b00;labelBackgroundColor=#ffffff;labelBorderColor=#d6b656;whiteSpace=wrap;labelWidth=1900;align=left;spacing=8;fontSize=13;" edge="1" parent="t1" source="tp5" target="ts5"><mxGeometry x="0" y="-125" width="1900" height="170" relative="1" as="geometry"/></mxCell>

        <mxCell id="tp6" value="/sensor_health_monitor ×2&lt;br&gt;&lt;b&gt;LaserScan watchdog&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" vertex="1" parent="t1"><mxGeometry x="40" y="1570" width="320" height="90" as="geometry"/></mxCell><mxCell id="ts6" value="mission_manager / executor&lt;br&gt;aed_hmi_bridge / event_logger&lt;br&gt;&lt;b&gt;Health subscribers&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" vertex="1" parent="t1"><mxGeometry x="2480" y="1560" width="420" height="110" as="geometry"/></mxCell>
        <mxCell id="te6" value="&lt;b&gt;/{robot_id}/sensor_health　[TOPIC]&lt;/b&gt;&lt;br&gt;Type = aed_interfaces/msg/SensorHealth&lt;br&gt;Data = robot_id:string; stamp:Time; lidar_status:uint8 {OK=0,LIDAR_STALE=1,LIDAR_INVALID=2,LIDAR_DEAD=3}; scan_age_s:float32; valid_ratio:float32[0..1]; degraded:bool; manual_drive_active:bool; detail:string&lt;br&gt;QoS target = RELIABLE + VOLATILE + KEEP_LAST depth 10; 2–5 Hz + transition immediate&lt;br&gt;Safety = degraded=true이면 새 Nav2 goal 금지; manual_drive_active이면 sensor_recovery만 cmd_vel writer" style="edgeStyle=none;html=1;endArrow=block;strokeWidth=2;dashed=1;strokeColor=#d79b00;labelBackgroundColor=#ffffff;labelBorderColor=#d6b656;whiteSpace=wrap;labelWidth=1900;align=left;spacing=8;fontSize=13;" edge="1" parent="t1" source="tp6" target="ts6"><mxGeometry x="0" y="-105" width="1900" height="140" relative="1" as="geometry"/></mxCell>

        <mxCell id="tp7" value="vision / robot nodes&lt;br&gt;&lt;b&gt;Heartbeat publishers&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" vertex="1" parent="t1"><mxGeometry x="40" y="1845" width="320" height="90" as="geometry"/></mxCell><mxCell id="ts7" value="/recovery_manager&lt;br&gt;&lt;b&gt;timeout watchdog&lt;/b&gt;&lt;br&gt;→ NETWORK_LOST transition" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" vertex="1" parent="t1"><mxGeometry x="2480" y="1835" width="420" height="110" as="geometry"/></mxCell>
        <mxCell id="te7" value="&lt;b&gt;/{sender_id}/heartbeat　[TOPIC]&lt;/b&gt;&lt;br&gt;Type = aed_interfaces/msg/Heartbeat　|　Data = sender_id:string globally unique; stamp:Time; sequence:uint32 monotonic&lt;br&gt;QoS target = RELIABLE + VOLATILE + KEEP_LAST depth 10; period 1.0 s; deadline recommended 1.5 s&lt;br&gt;Watchdog = steady-clock receive time 사용; 권장 3회 누락 후 timeout; 상태 전이당 NETWORK_LOST 한 번만 발행" style="edgeStyle=none;html=1;endArrow=block;strokeWidth=2;dashed=1;strokeColor=#d79b00;labelBackgroundColor=#ffffff;labelBorderColor=#d6b656;whiteSpace=wrap;labelWidth=1900;align=left;spacing=8;fontSize=13;" edge="1" parent="t1" source="tp7" target="ts7"><mxGeometry x="0" y="-85" width="1900" height="115" relative="1" as="geometry"/></mxCell>

        <mxCell id="tn" value="코드 작성 전 확정 필요: ① aggregate EmergencyEvent publisher 소유 노드 ② CONGESTED 시 두 대 출동과 single-active 정책 ③ MissionStatus 상태별 발행 권한 및 durability ④ CrowdLevel 발행 주기 ⑤ Heartbeat timeout ⑥ sensor_recovery cmd_vel arbitration ⑦ MissionAssignment 제거/DeliverAed 전환 시점" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacing=14;fontSize=15;fontStyle=1;" vertex="1" parent="t1"><mxGeometry x="150" y="2110" width="2700" height="105" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="hmi" name="04_HMI_Front_Back_Flow">
    <mxGraphModel dx="2200" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="3000" pageHeight="2200" math="0" shadow="0">
      <root><mxCell id="h0"/><mxCell id="h1" parent="h0"/>
        <mxCell id="ht" value="HMI FRONTEND ↔ BACKEND — Transport and JSON Data Contract" style="text;html=1;fontSize=28;fontStyle=1;" vertex="1" parent="h1"><mxGeometry x="40" y="20" width="2000" height="45" as="geometry"/></mxCell>
        <mxCell id="hp1" value="RosBridge OR MockSimulator&lt;br&gt;&lt;b&gt;Context callbacks&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="h1"><mxGeometry x="40" y="220" width="340" height="95" as="geometry"/></mxCell><mxCell id="hs1" value="Backend Context&lt;br&gt;&lt;b&gt;LiveState + Repository&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="h1"><mxGeometry x="2500" y="220" width="400" height="95" as="geometry"/></mxCell>
        <mxCell id="he1" value="&lt;b&gt;IN-PROCESS DOMAIN CALLBACKS&lt;/b&gt;&lt;br&gt;on_robot(RobotSnapshot); on_event(EmergencyEventSnapshot); on_mission(MissionEvent); on_assignment(mission_id:string, version:int, event_id:string, robot_id:string, role:string, target:Point2D, assigned_at:float epoch); on_frame(stream_id:string, jpeg:bytes); on_person_count(stream_id:string,count:int)&lt;br&gt;Threading = ROS/mock worker writes; LiveState lock protects latest state; Repository uses thread-local SQLite connection" style="edgeStyle=none;html=1;endArrow=block;strokeWidth=2;labelBackgroundColor=#ffffff;labelBorderColor=#82b366;whiteSpace=wrap;labelWidth=1900;align=left;spacing=8;fontSize=13;" edge="1" parent="h1" source="hp1" target="hs1"><mxGeometry x="0" y="-95" width="1900" height="125" relative="1" as="geometry"/></mxCell>

        <mxCell id="hp2" value="FastAPI Hub&lt;br&gt;&lt;b&gt;build_snapshot() every 0.25 s&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="h1"><mxGeometry x="40" y="490" width="340" height="95" as="geometry"/></mxCell><mxCell id="hs2" value="React LiveSocket&lt;br&gt;&lt;b&gt;useLiveSnapshot()&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="h1"><mxGeometry x="2500" y="490" width="400" height="95" as="geometry"/></mxCell>
        <mxCell id="he2" value="&lt;b&gt;/ws/live　[WEBSOCKET, server push 4 Hz]&lt;/b&gt;&lt;br&gt;Envelope = {type:'snapshot', data:SystemSnapshot}&lt;br&gt;SystemSnapshot = stamp:number(epoch s); robots:RobotSnapshot[]; active_event:EmergencyEventSnapshot|null; active_missions:MissionSummary[]; streams:StreamHealth[]; ros_connected:boolean&lt;br&gt;Client = silence timeout 6000 ms; reconnect exponential 500→8000 ms; malformed JSON frame ignored" style="edgeStyle=none;html=1;endArrow=block;strokeWidth=2;labelBackgroundColor=#ffffff;labelBorderColor=#82b366;whiteSpace=wrap;labelWidth=1900;align=left;spacing=8;fontSize=13;" edge="1" parent="h1" source="hp2" target="hs2"><mxGeometry x="0" y="-95" width="1900" height="125" relative="1" as="geometry"/></mxCell>

        <mxCell id="hp3" value="SystemSnapshot serializer&lt;br&gt;&lt;b&gt;backend/domain/serialize.py&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="h1"><mxGeometry x="40" y="760" width="340" height="95" as="geometry"/></mxCell><mxCell id="hs3" value="frontend/types/telemetry.ts&lt;br&gt;&lt;b&gt;RobotCard / ActiveEvent / ETA&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="h1"><mxGeometry x="2500" y="750" width="400" height="115" as="geometry"/></mxCell>
        <mxCell id="he3" value="&lt;b&gt;RobotSnapshot JSON (inside SystemSnapshot)&lt;/b&gt;&lt;br&gt;robot_id:string; stamp:number; position:{x:number,y:number}; yaw_deg:number; battery_percentage:number; availability:RobotAvailability string union; role:RobotRole string union; mission_id:string; is_docked/network_ok/localization_ok/nav2_ok/emergency_stop/path_valid:boolean; estimated_path_cost:number; last_heartbeat:number; detail:string; speed_mps:number; heartbeat_age_s:number; healthy:boolean&lt;br&gt;Rule = backend Python model과 frontend TypeScript interface는 field-for-field 1:1" style="edgeStyle=none;html=1;endArrow=block;strokeWidth=2;labelBackgroundColor=#ffffff;labelBorderColor=#82b366;whiteSpace=wrap;labelWidth=1900;align=left;spacing=8;fontSize=13;" edge="1" parent="h1" source="hp3" target="hs3"><mxGeometry x="0" y="-105" width="1900" height="140" relative="1" as="geometry"/></mxCell>

        <mxCell id="hp4" value="Repository / history API&lt;br&gt;&lt;b&gt;SQLite query result&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="h1"><mxGeometry x="40" y="1040" width="340" height="95" as="geometry"/></mxCell><mxCell id="hs4" value="MissionTable&lt;br&gt;&lt;b&gt;HTTP fetch every 5 s&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="h1"><mxGeometry x="2500" y="1040" width="400" height="95" as="geometry"/></mxCell>
        <mxCell id="he4" value="&lt;b&gt;REST JSON — GET /api/missions?limit:int[1..500]&lt;/b&gt;&lt;br&gt;Response = {items:MissionSummary[]}　|　MissionSummary = mission_id/event_id/robot_id:string; target:{x:number,y:number}; called_at:number; dispatched_at/arrived_at:number|null; final_state:MissionState; assignment_version/reassignment_count:number; failure_reasons:string[]; response_seconds/eta_seconds/eta_at/eta_distance_m:number|null; eta_confident:boolean&lt;br&gt;Also = GET /api/missions/{mission_id:string} → {mission_id,timeline:MissionEvent[]}" style="edgeStyle=none;html=1;endArrow=block;strokeWidth=2;labelBackgroundColor=#ffffff;labelBorderColor=#82b366;whiteSpace=wrap;labelWidth=1900;align=left;spacing=8;fontSize=13;" edge="1" parent="h1" source="hp4" target="hs4"><mxGeometry x="0" y="-105" width="1900" height="140" relative="1" as="geometry"/></mxCell>

        <mxCell id="hp5" value="FrameRegistry&lt;br&gt;&lt;b&gt;latest JPEG per stream&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="h1"><mxGeometry x="40" y="1320" width="340" height="95" as="geometry"/></mxCell><mxCell id="hs5" value="VideoWall / VideoTile&lt;br&gt;&lt;b&gt;&amp;lt;img src=...&amp;gt;&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="h1"><mxGeometry x="2500" y="1320" width="400" height="95" as="geometry"/></mxCell>
        <mxCell id="he5" value="&lt;b&gt;GET /api/video/{stream_id}　[MJPEG]&lt;/b&gt;&lt;br&gt;stream_id:string enum-like {'camera_open','camera_alley','robot1','robot2'}　|　Response Content-Type = multipart/x-mixed-replace; boundary=aedframe; each part Content-Type=image/jpeg, Content-Length:int, body:uint8[]&lt;br&gt;GET /api/video/{stream_id}/snapshot → image/jpeg; unknown stream 404; no frame 503; idle wait 1.0 s; Cache-Control:no-store" style="edgeStyle=none;html=1;endArrow=block;strokeWidth=2;labelBackgroundColor=#ffffff;labelBorderColor=#82b366;whiteSpace=wrap;labelWidth=1900;align=left;spacing=8;fontSize=13;" edge="1" parent="h1" source="hp5" target="hs5"><mxGeometry x="0" y="-95" width="1900" height="125" relative="1" as="geometry"/></mxCell>

        <mxCell id="hp6" value="Repository statistics&lt;br&gt;&lt;b&gt;aggregate SQL&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="h1"><mxGeometry x="40" y="1590" width="340" height="95" as="geometry"/></mxCell><mxCell id="hs6" value="Frontend metrics / debug tools&lt;br&gt;&lt;b&gt;HTTP clients&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="h1"><mxGeometry x="2500" y="1590" width="400" height="95" as="geometry"/></mxCell>
        <mxCell id="he6" value="&lt;b&gt;REST STATS / HEALTH&lt;/b&gt;&lt;br&gt;GET /api/stats/response-time → {total:int,arrived:int,avg_seconds/min_seconds/max_seconds:number|null}&lt;br&gt;GET /api/stats/travel-time → travel stats + assumptions:{cruise_speed_mps,cruise_efficiency,detour_factor:number}&lt;br&gt;GET /api/stats/eta-accuracy?limit:int → error statistics + recent:EtaRecord[]　|　GET /api/robots/{robot_id:string}/track?limit:int[1..5000] → points　|　GET /api/health → process/ROS/mock/stream/client counts" style="edgeStyle=none;html=1;endArrow=block;strokeWidth=2;labelBackgroundColor=#ffffff;labelBorderColor=#82b366;whiteSpace=wrap;labelWidth=1900;align=left;spacing=8;fontSize=13;" edge="1" parent="h1" source="hp6" target="hs6"><mxGeometry x="0" y="-105" width="1900" height="140" relative="1" as="geometry"/></mxCell>

        <mxCell id="hn" value="SQLite data authority: emergency_events(event_id PK, upsert status); mission_assignments(mission_id+version PK); mission_events(id PK, append-only); robot_samples(id PK, 1 Hz sampled); eta_records(request_id+robot_id PK). 모든 시각은 UTC epoch seconds REAL/number로 통일." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacing=14;fontSize=15;" vertex="1" parent="h1"><mxGeometry x="150" y="1840" width="2700" height="90" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
