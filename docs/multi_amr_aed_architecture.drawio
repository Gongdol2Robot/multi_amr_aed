  </diagram>
  <diagram id="target-detail" name="06_TARGET_Interface_Contract">
    <mxGraphModel dx="1800" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="2200" math="0" shadow="0">
      <root><mxCell id="t0"/><mxCell id="t1" parent="t0"/>
        <mxCell id="tt" value="TARGET DESIGN — Code-Ready ROS 2 Interface Contract (No Crossed Lines)" style="text;html=1;fontSize=26;fontStyle=1;" vertex="1" parent="t1"><mxGeometry x="40" y="20" width="1550" height="45" as="geometry"/></mxCell>
        <mxCell id="tl" value="이 페이지는 구현 목표입니다. 각 행의 Interface 카드가 소스 코드의 publisher/subscriber/service/action server-client 계약입니다." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacing=10;fontSize=14;" vertex="1" parent="t1"><mxGeometry x="40" y="75" width="1960" height="55" as="geometry"/></mxCell>
        <mxCell id="th1" value="PRODUCER / CLIENT" style="text;html=1;fontSize=16;fontStyle=1;align=center;" vertex="1" parent="t1"><mxGeometry x="50" y="145" width="300" height="30" as="geometry"/></mxCell><mxCell id="th2" value="INTERFACE CONTRACT" style="text;html=1;fontSize=16;fontStyle=1;align=center;" vertex="1" parent="t1"><mxGeometry x="400" y="145" width="1050" height="30" as="geometry"/></mxCell><mxCell id="th3" value="CONSUMER / SERVER" style="text;html=1;fontSize=16;fontStyle=1;align=center;" vertex="1" parent="t1"><mxGeometry x="1520" y="145" width="430" height="30" as="geometry"/></mxCell>
        <mxCell id="tp1" value="119 dispatcher / Operator HMI&lt;br&gt;ReportEmergency Client" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;" vertex="1" parent="t1"><mxGeometry x="50" y="215" width="300" height="90" as="geometry"/></mxCell>
        <mxCell id="ti1" value="&lt;b&gt;S /aed/report_emergency&lt;/b&gt; — aed_interfaces/srv/ReportEmergency&lt;br&gt;REQUEST: location:PointStamped(map); source_id:string {'119-dispatch','operator'}; zone_id:string; confidence:float32 [0..1]&lt;br&gt;RESPONSE: accepted:bool; event_id:string generated when accepted; reason:string rejection reason&lt;br&gt;Semantic: 즉시 접수/중복검사만 수행, 장시간 주행 금지. Idempotency 기준은 동일 source+location+시간창 또는 event ID 정책으로 구현 필요." style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;dashed=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacing=10;fontSize=13;" vertex="1" parent="t1"><mxGeometry x="400" y="190" width="1050" height="140" as="geometry"/></mxCell>
        <mxCell id="ts1" value="/emergency_intake&lt;br&gt;ReportEmergency ServiceServer&lt;br&gt;→ EmergencyEvent CONFIRMED publish&lt;br&gt;현재 노드 미구현" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="t1"><mxGeometry x="1520" y="205" width="430" height="110" as="geometry"/></mxCell>
        <mxCell id="tp2" value="/{camera_id}/vision_detector&lt;br&gt;YOLO + homography" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;" vertex="1" parent="t1"><mxGeometry x="50" y="390" width="300" height="90" as="geometry"/></mxCell>
        <mxCell id="ti2" value="&lt;b&gt;T /{camera_id}/vision/detections&lt;/b&gt; — aed_interfaces/msg/DetectionSummary&lt;br&gt;camera_id:string; stamp:Time; person_count:uint32; fallen_count:uint32; helper_count:uint32; top_fallen_confidence:float32; top_helper_confidence:float32; fallen_location:PointStamped&lt;br&gt;Validity: homography 불가 시 fallen_location.header.frame_id=''; counts are current-frame values; confidences [0..1]&lt;br&gt;QoS target: BEST_EFFORT, VOLATILE, KEEP_LAST depth=1 (frame summary는 최신 값만 의미 있음). Publish every processed frame." style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;dashed=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacing=10;fontSize=13;" vertex="1" parent="t1"><mxGeometry x="400" y="355" width="1050" height="160" as="geometry"/></mxCell>
        <mxCell id="ts2" value="Subscribers&lt;br&gt;/aed_hmi_bridge: counts + location display&lt;br&gt;/helper_mission_controller: helper_count 판단&lt;br&gt;/emergency_intake: fallen detection source" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="t1"><mxGeometry x="1520" y="375" width="430" height="120" as="geometry"/></mxCell>
        <mxCell id="tp3" value="/{camera_id}/vision_detector&lt;br&gt;crowd evaluator" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;" vertex="1" parent="t1"><mxGeometry x="50" y="570" width="300" height="90" as="geometry"/></mxCell>
        <mxCell id="ti3" value="&lt;b&gt;T /{camera_id}/vision/crowd_level&lt;/b&gt; — aed_interfaces/msg/CrowdLevel&lt;br&gt;camera_id:string; zone_id:string; stamp:Time; level:uint8 {CLEAR=0, MODERATE=1, CONGESTED=2}; person_count:uint32; threshold:uint32; roi_occupancy:float32 [0..1]&lt;br&gt;Semantic: level 판단 근거(person_count/threshold/occupancy)를 같은 sample에 포함. EmergencyEvent.crowd_level에 이벤트 확정 순간 값을 복사.&lt;br&gt;QoS target: RELIABLE, VOLATILE, KEEP_LAST depth=10. Publish on each evaluation or level change policy를 파라미터로 확정." style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;dashed=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacing=10;fontSize=13;" vertex="1" parent="t1"><mxGeometry x="400" y="535" width="1050" height="165" as="geometry"/></mxCell>
        <mxCell id="ts3" value="Subscribers&lt;br&gt;/emergency_intake → event crowd snapshot&lt;br&gt;/mission_manager → one/two robot policy&lt;br&gt;/aed_hmi_bridge → evidence display/history" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="t1"><mxGeometry x="1520" y="555" width="430" height="125" as="geometry"/></mxCell>
        <mxCell id="tp4" value="/robot_state_monitor ×2&lt;br&gt;odom/battery/dock/health aggregator" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;" vertex="1" parent="t1"><mxGeometry x="50" y="755" width="300" height="95" as="geometry"/></mxCell>
        <mxCell id="ti4" value="&lt;b&gt;T /aed/robot_state&lt;/b&gt; — aed_interfaces/msg/RobotState&lt;br&gt;Required inputs internally: /{robot}/odom, battery_state, dock_status, localization status, Nav2 lifecycle/health, heartbeat, path validation/cost&lt;br&gt;Output fields/types: robot_id:string; stamp:Time; pose:PoseStamped(map); speed_mps/battery/path_cost:float32; availability/role:uint8; mission_id:string; 6 health flags:bool; last_heartbeat:Time; detail:string&lt;br&gt;QoS target: RELIABLE, VOLATILE, KEEP_LAST depth=20; rate target 5 Hz; stale at HMI after 6 s." style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;dashed=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacing=10;fontSize=13;" vertex="1" parent="t1"><mxGeometry x="400" y="720" width="1050" height="165" as="geometry"/></mxCell>
        <mxCell id="ts4" value="Subscribers&lt;br&gt;/mission_manager candidate eligibility/rank&lt;br&gt;/aed_hmi_bridge live card/ETA/DB sample&lt;br&gt;/event_logger audit history" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="t1"><mxGeometry x="1520" y="740" width="430" height="125" as="geometry"/></mxCell>
        <mxCell id="tp5" value="/mission_manager&lt;br&gt;DeliverAed ActionClient ×2&lt;br&gt;cancel old + send new goal" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;" vertex="1" parent="t1"><mxGeometry x="50" y="955" width="300" height="105" as="geometry"/></mxCell>
        <mxCell id="ti5" value="&lt;b&gt;A /{robot_id}/deliver_aed&lt;/b&gt; — aed_interfaces/action/DeliverAed&lt;br&gt;GOAL: mission_id/event_id:string; role:uint8; target:PoseStamped(map); crowd_level:uint8; requested_at:Time&lt;br&gt;FEEDBACK: state:uint8 (MissionStatus semantics); current_pose:PoseStamped; speed_mps/distance_remaining_m/eta_seconds:float32; eta&lt;0 means unavailable&lt;br&gt;RESULT: outcome:uint8 {SUCCESS, ABORTED_NAVIGATION, ABORTED_NETWORK, ABORTED_SENSOR, CANCELED}; started_at/finished_at:Time; travelled_m:float32; final_pose:PoseStamped; detail:string&lt;br&gt;Behavior: failure/reassignment → cancel_goal; exactly one active AED goal per event unless CONGESTED policy explicitly requests two." style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;dashed=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacing=10;fontSize=13;" vertex="1" parent="t1"><mxGeometry x="400" y="910" width="1050" height="195" as="geometry"/></mxCell>
        <mxCell id="ts5" value="/{robot_id}/mission_executor&lt;br&gt;DeliverAed ActionServer&lt;br&gt;internally calls NavigateToPose&lt;br&gt;feedback timer + cancel callback + result mapping" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="t1"><mxGeometry x="1520" y="945" width="430" height="125" as="geometry"/></mxCell>
        <mxCell id="tp6" value="/sensor_health_monitor ×2&lt;br&gt;LaserScan watchdog" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;" vertex="1" parent="t1"><mxGeometry x="50" y="1170" width="300" height="90" as="geometry"/></mxCell>
        <mxCell id="ti6" value="&lt;b&gt;T /{robot_id}/sensor_health&lt;/b&gt; — aed_interfaces/msg/SensorHealth&lt;br&gt;robot_id:string; stamp:Time; lidar_status:uint8 {OK=0,LIDAR_STALE=1,LIDAR_INVALID=2,LIDAR_DEAD=3}; scan_age_s:float32; valid_ratio:float32 [0..1]; degraded:bool; manual_drive_active:bool; detail:string&lt;br&gt;QoS target: RELIABLE, VOLATILE, KEEP_LAST depth=10; publish periodic 2–5 Hz and immediately on status transition.&lt;br&gt;Safety invariant: degraded=true 동안 mission_manager/mission_executor는 새 Nav2 goal 금지. manual_drive_active=true인 동안 cmd_vel writer는 sensor_recovery 하나만 허용." style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;dashed=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacing=10;fontSize=13;" vertex="1" parent="t1"><mxGeometry x="400" y="1130" width="1050" height="175" as="geometry"/></mxCell>
        <mxCell id="ts6" value="Subscribers&lt;br&gt;/mission_manager eligibility/failover&lt;br&gt;/{robot}/mission_executor abort sensor&lt;br&gt;/aed_hmi_bridge warning card&lt;br&gt;/event_logger fault audit" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="t1"><mxGeometry x="1520" y="1150" width="430" height="135" as="geometry"/></mxCell>
        <mxCell id="tp7" value="vision / robot / recovery nodes&lt;br&gt;Heartbeat publisher" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;" vertex="1" parent="t1"><mxGeometry x="50" y="1360" width="300" height="90" as="geometry"/></mxCell>
        <mxCell id="ti7" value="&lt;b&gt;T /{sender_id}/heartbeat&lt;/b&gt; — aed_interfaces/msg/Heartbeat&lt;br&gt;sender_id:string globally unique; stamp:Time source clock; sequence:uint32 monotonic with wrap policy&lt;br&gt;QoS target: RELIABLE, VOLATILE, KEEP_LAST depth=10; period=1.0 s; deadline policy recommended 1.5 s.&lt;br&gt;Watchdog contract: recovery_manager stores last receive time (steady clock), declares NETWORK_LOST after configurable timeout (recommended 3 missed beats), publishes failure state once per transition, not every timer tick." style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;dashed=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacing=10;fontSize=13;" vertex="1" parent="t1"><mxGeometry x="400" y="1330" width="1050" height="150" as="geometry"/></mxCell>
        <mxCell id="ts7" value="/recovery_manager&lt;br&gt;Heartbeat subscribers&lt;br&gt;timeout state machine&lt;br&gt;→ RobotState.network_ok / MissionStatus.NETWORK_LOST" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="t1"><mxGeometry x="1520" y="1350" width="430" height="115" as="geometry"/></mxCell>
        <mxCell id="tp8" value="mission_manager / executor / helper&lt;br&gt;state transition publishers" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;" vertex="1" parent="t1"><mxGeometry x="50" y="1545" width="300" height="95" as="geometry"/></mxCell>
        <mxCell id="ti8" value="&lt;b&gt;T /aed/mission_status&lt;/b&gt; — aed_interfaces/msg/MissionStatus&lt;br&gt;mission_id/event_id/robot_id:string; assignment_version:uint32; status:uint8; stamp:Time; reason:string&lt;br&gt;Authority rule: mission_manager publishes ASSIGNED/RECOVERY_*; executor publishes DISPATCHING/EN_ROUTE/ARRIVED/CANCELED/NAVIGATION_ERROR; recovery publishes NETWORK_LOST/BLOCKED; helper publishes HELPER_*; duplicate transition policy required.&lt;br&gt;QoS target: RELIABLE, TRANSIENT_LOCAL recommended for last transitions, KEEP_LAST depth≥20; event_logger stores every transition append-only." style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;dashed=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacing=10;fontSize=13;" vertex="1" parent="t1"><mxGeometry x="400" y="1510" width="1050" height="165" as="geometry"/></mxCell>
        <mxCell id="ts8" value="Subscribers&lt;br&gt;/mission_manager failover/terminal&lt;br&gt;/aed_hmi_bridge live + DB&lt;br&gt;/event_logger authoritative audit&lt;br&gt;/helper_mission_controller arrival trigger" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="t1"><mxGeometry x="1520" y="1530" width="430" height="130" as="geometry"/></mxCell>
        <mxCell id="tnote" value="IMPLEMENTATION DECISIONS STILL REQUIRED BEFORE CODE FREEZE&lt;br&gt;1) /aed/emergency_event aggregate publisher node ownership　2) CrowdLevel 발행 주기　3) CONGESTED 시 2대 출동 정책과 단일-active 원칙 조정　4) MissionStatus durability/authority/duplicate rule　5) Heartbeat timeout/deadline　6) Sensor degraded 시 대체주행 안전 arbitration　7) DeliverAed 전환 후 MissionAssignment 제거 시점" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacing=12;fontSize=14;fontStyle=1;" vertex="1" parent="t1"><mxGeometry x="100" y="1780" width="1800" height="120" as="geometry"/></mxCell>
        <mxCell id="te1a" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;dashed=1;strokeColor=#d79b00;" edge="1" parent="t1" source="tp1" target="ti1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="te1b" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;dashed=1;strokeColor=#d79b00;" edge="1" parent="t1" source="ti1" target="ts1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="te2a" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;dashed=1;strokeColor=#d79b00;" edge="1" parent="t1" source="tp2" target="ti2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="te2b" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;dashed=1;strokeColor=#d79b00;" edge="1" parent="t1" source="ti2" target="ts2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="te3a" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;dashed=1;strokeColor=#d79b00;" edge="1" parent="t1" source="tp3" target="ti3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="te3b" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;dashed=1;strokeColor=#d79b00;" edge="1" parent="t1" source="ti3" target="ts3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="te4a" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;dashed=1;strokeColor=#d79b00;" edge="1" parent="t1" source="tp4" target="ti4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="te4b" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;dashed=1;strokeColor=#d79b00;" edge="1" parent="t1" source="ti4" target="ts4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="te5a" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;startArrow=block;startFill=1;dashed=1;strokeColor=#d79b00;" edge="1" parent="t1" source="tp5" target="ti5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="te5b" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;startArrow=block;startFill=1;dashed=1;strokeColor=#d79b00;" edge="1" parent="t1" source="ti5" target="ts5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="te6a" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;dashed=1;strokeColor=#d79b00;" edge="1" parent="t1" source="tp6" target="ti6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="te6b" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;dashed=1;strokeColor=#d79b00;" edge="1" parent="t1" source="ti6" target="ts6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="te7a" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;dashed=1;strokeColor=#d79b00;" edge="1" parent="t1" source="tp7" target="ti7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="te7b" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;dashed=1;strokeColor=#d79b00;" edge="1" parent="t1" source="ti7" target="ts7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="te8a" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;dashed=1;strokeColor=#d79b00;" edge="1" parent="t1" source="tp8" target="ti8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="te8b" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;dashed=1;strokeColor=#d79b00;" edge="1" parent="t1" source="ti8" target="ts8"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
