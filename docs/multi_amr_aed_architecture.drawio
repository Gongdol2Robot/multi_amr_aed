  <diagram id="system" name="01_System_HW_SW">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="s-title" value="Multi-AMR AED Response System — HW / SW / Communication Boundary" style="text;html=1;fontSize=24;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="1200" height="40" as="geometry"/></mxCell>
        <mxCell id="s-legend" value="범례: &lt;b&gt;실선 = 현재 코드 구현&lt;/b&gt;　 &lt;span style=&quot;color:#d79b00&quot;&gt;점선 = 목표 인터페이스/미구현 scaffold&lt;/span&gt;　 파랑=ROS2　 초록=HMI　 보라=HW" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacing=10;" vertex="1" parent="1"><mxGeometry x="30" y="70" width="1220" height="45" as="geometry"/></mxCell>
        <mxCell id="s-hw" value="HARDWARE / FIELD" style="swimlane;html=1;rounded=1;startSize=35;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="140" width="430" height="780" as="geometry"/></mxCell>
        <mxCell id="s-cam1" value="Fixed Webcam 1&lt;br&gt;&lt;b&gt;camera_open&lt;/b&gt;&lt;br&gt;USB / 640×480 JPEG" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="70" y="200" width="160" height="90" as="geometry"/></mxCell>
        <mxCell id="s-cam2" value="Fixed Webcam 2&lt;br&gt;&lt;b&gt;camera_alley&lt;/b&gt;&lt;br&gt;USB / 640×480 JPEG" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="260" y="200" width="160" height="90" as="geometry"/></mxCell>
        <mxCell id="s-tb1" value="TurtleBot4 #1&lt;br&gt;Create3 + RPi&lt;br&gt;LiDAR + OAK-D + AED&lt;br&gt;Nav2 / Dock1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="70" y="430" width="160" height="110" as="geometry"/></mxCell>
        <mxCell id="s-tb2" value="TurtleBot4 #2&lt;br&gt;Create3 + RPi&lt;br&gt;LiDAR + OAK-D + AED&lt;br&gt;Nav2 / Dock2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="260" y="430" width="160" height="110" as="geometry"/></mxCell>
        <mxCell id="s-operator" value="Operator PC / Browser&lt;br&gt;React HMI&lt;br&gt;1920×1080 관제 화면" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="165" y="700" width="170" height="90" as="geometry"/></mxCell>
        <mxCell id="s-ros" value="ROS 2 HUMBLE SOFTWARE BOUNDARY (DDS / ROS_DOMAIN_ID)" style="swimlane;html=1;rounded=1;startSize=35;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="500" y="140" width="720" height="530" as="geometry"/></mxCell>
        <mxCell id="s-vision" value="&lt;b&gt;aed_vision&lt;/b&gt;&lt;br&gt;webcam_publisher&lt;br&gt;vision_detector (YOLO)&lt;br&gt;homography" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="540" y="200" width="180" height="105" as="geometry"/></mxCell>
        <mxCell id="s-mgr" value="&lt;b&gt;mission_manager&lt;/b&gt;&lt;br&gt;confirmed event 수신&lt;br&gt;path cost 후보 순위&lt;br&gt;단일 로봇 배정/재할당" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="790" y="200" width="190" height="110" as="geometry"/></mxCell>
        <mxCell id="s-exec" value="&lt;b&gt;robot_missions ×2&lt;/b&gt;&lt;br&gt;mission_executor&lt;br&gt;NavigateToPose client&lt;br&gt;MissionStatus publisher" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1030" y="200" width="160" height="110" as="geometry"/></mxCell>
        <mxCell id="s-state" value="robot_state_monitor ×2&lt;br&gt;&lt;i&gt;scaffold / target&lt;/i&gt;&lt;br&gt;pose, speed, battery,&lt;br&gt;network/nav2/localization" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="540" y="390" width="180" height="110" as="geometry"/></mxCell>
        <mxCell id="s-recovery" value="amr_recovery / sensor_recovery&lt;br&gt;&lt;i&gt;scaffold / target&lt;/i&gt;&lt;br&gt;Heartbeat, SensorHealth,&lt;br&gt;safe stop / failover" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="790" y="390" width="190" height="110" as="geometry"/></mxCell>
        <mxCell id="s-helper" value="helper_mission / emergency_alert&lt;br&gt;helper detector + siren&lt;br&gt;&lt;i&gt;controller scaffold&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1030" y="390" width="160" height="110" as="geometry"/></mxCell>
        <mxCell id="s-hmi" value="HMI SOFTWARE BOUNDARY" style="swimlane;html=1;rounded=1;startSize=35;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="500" y="700" width="720" height="220" as="geometry"/></mxCell>
        <mxCell id="s-bridge" value="FastAPI Backend&lt;br&gt;&lt;b&gt;RosBridge → Context&lt;/b&gt;&lt;br&gt;LiveState / FrameRegistry" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="540" y="770" width="190" height="95" as="geometry"/></mxCell>
        <mxCell id="s-db" value="SQLite (WAL)&lt;br&gt;events / assignments&lt;br&gt;mission transitions&lt;br&gt;robot samples / ETA" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="790" y="770" width="150" height="100" as="geometry"/></mxCell>
        <mxCell id="s-front" value="React + TypeScript&lt;br&gt;LiveSocket / REST client&lt;br&gt;VideoWall / RobotCard&lt;br&gt;Mission &amp; ETA panels" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1000" y="770" width="180" height="100" as="geometry"/></mxCell>
        <mxCell id="s-note" value="외부 통신&lt;br&gt;ROS2: DDS (Topic / Service / Action)&lt;br&gt;HMI: WebSocket JSON 4 Hz, REST JSON, MJPEG&lt;br&gt;개발/시연: MockSimulator가 RosBridge와 동일 Context 입력 사용" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacing=10;" vertex="1" parent="1"><mxGeometry x="1270" y="180" width="430" height="145" as="geometry"/></mxCell>
        <mxCell id="se1" value="CompressedImage" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="s-cam1" target="s-vision"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="se2" value="CompressedImage" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="s-cam2" target="s-vision"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="se3" value="EmergencyEvent" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="s-vision" target="s-mgr"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="se4" value="MissionAssignment (current)&lt;br&gt;DeliverAed (target)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="s-mgr" target="s-exec"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="se5" value="NavigateToPose" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="s-exec" target="s-tb1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="se6" value="NavigateToPose" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="s-exec" target="s-tb2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="se7" value="ROS subscriptions" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="s-ros" target="s-bridge"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="se8" value="SQL" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="s-bridge" target="s-db"><mxGeometry relative="1" as="geometry"/></mxCell>
