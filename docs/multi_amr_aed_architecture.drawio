  <diagram id="flow" name="02_Function_Flow">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1100" math="0" shadow="0">
      <root><mxCell id="f0"/><mxCell id="f1" parent="f0"/>
        <mxCell id="ft" value="Functional Flow — Detection → Dispatch → Delivery → Recovery" style="text;html=1;fontSize=24;fontStyle=1;align=left;" vertex="1" parent="f1"><mxGeometry x="30" y="20" width="1100" height="40" as="geometry"/></mxCell>
        <mxCell id="fl" value="각 단계 박스: 담당 노드 / 입력 인터페이스 / 핵심 처리 / 출력 인터페이스" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="f1"><mxGeometry x="30" y="70" width="850" height="40" as="geometry"/></mxCell>
        <mxCell id="f2" value="1. IMAGE ACQUISITION&lt;br&gt;&lt;b&gt;webcam_publisher / OAK-D driver&lt;/b&gt;&lt;br&gt;Input: USB camera frame&lt;br&gt;Output Topic: /{camera_id}/image_raw/compressed&lt;br&gt;sensor_msgs/CompressedImage" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;spacing=8;" vertex="1" parent="f1"><mxGeometry x="40" y="160" width="260" height="135" as="geometry"/></mxCell>
        <mxCell id="f3" value="2. DETECT &amp; MAP&lt;br&gt;&lt;b&gt;vision_detector + homography&lt;/b&gt;&lt;br&gt;YOLO: person/fallen/helper&lt;br&gt;pixel footpoint → map PointStamped&lt;br&gt;연속 검출 임계값으로 CONFIRMED" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacing=8;" vertex="1" parent="f1"><mxGeometry x="360" y="160" width="270" height="135" as="geometry"/></mxCell>
        <mxCell id="f4" value="3. EVENT INTAKE&lt;br&gt;&lt;b&gt;mission_manager&lt;/b&gt;&lt;br&gt;Input: EmergencyEvent.status=CONFIRMED&lt;br&gt;중복 event_id 제거 / frame_id 검증&lt;br&gt;context 생성" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacing=8;" vertex="1" parent="f1"><mxGeometry x="690" y="160" width="270" height="135" as="geometry"/></mxCell>
        <mxCell id="f5" value="4. RANK ROBOTS&lt;br&gt;&lt;b&gt;rank_candidates()&lt;/b&gt;&lt;br&gt;Input: RobotState ×2&lt;br&gt;필터: AVAILABLE + network/localization/nav2 OK&lt;br&gt;path_valid면 estimated_path_cost, 아니면 거리" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacing=8;" vertex="1" parent="f1"><mxGeometry x="1020" y="160" width="300" height="135" as="geometry"/></mxCell>
        <mxCell id="f6" value="가용 후보 있음?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="f1"><mxGeometry x="1390" y="175" width="170" height="105" as="geometry"/></mxCell>
        <mxCell id="f7" value="5. ASSIGN / DISPATCH&lt;br&gt;&lt;b&gt;Current:&lt;/b&gt; /{robot}/mission_assignment Topic&lt;br&gt;&lt;b&gt;Target:&lt;/b&gt; /{robot}/deliver_aed Action Goal&lt;br&gt;mission_id, event_id, role, target, version/crowd" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacing=8;" vertex="1" parent="f1"><mxGeometry x="1240" y="390" width="320" height="135" as="geometry"/></mxCell>
        <mxCell id="f8" value="RECOVERY_WAIT&lt;br&gt;/aed/mission_status&lt;br&gt;MissionStatus.RECOVERY_WAIT&lt;br&gt;로봇 상태 회복 시 새 version/goal" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="f1"><mxGeometry x="1510" y="600" width="230" height="115" as="geometry"/></mxCell>
        <mxCell id="f9" value="6. EXECUTE NAVIGATION&lt;br&gt;&lt;b&gt;mission_executor × robot&lt;/b&gt;&lt;br&gt;Nav2 Action: /{robot}/navigate_to_pose&lt;br&gt;nav2_msgs/action/NavigateToPose&lt;br&gt;DISPATCHING → EN_ROUTE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacing=8;" vertex="1" parent="f1"><mxGeometry x="850" y="390" width="300" height="135" as="geometry"/></mxCell>
        <mxCell id="f10" value="Nav2 성공?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="f1"><mxGeometry x="600" y="405" width="170" height="105" as="geometry"/></mxCell>
        <mxCell id="f11" value="7. ARRIVAL&lt;br&gt;/aed/mission_status&lt;br&gt;MissionStatus.ARRIVED&lt;br&gt;event terminal=true&lt;br&gt;신고→도착 응답시간 저장" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacing=8;" vertex="1" parent="f1"><mxGeometry x="260" y="390" width="260" height="135" as="geometry"/></mxCell>
        <mxCell id="f12" value="8. HELPER / COMPLETE (target)&lt;br&gt;DetectionSummary.helper_count&lt;br&gt;0이면 helper mission + siren&lt;br&gt;HELPER_REQUESTED → ARRIVED&lt;br&gt;최종 COMPLETED / RESOLVED" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacing=8;" vertex="1" parent="f1"><mxGeometry x="40" y="390" width="180" height="150" as="geometry"/></mxCell>
        <mxCell id="f13" value="FAILURE / REALLOCATION&lt;br&gt;BLOCKED | NETWORK_LOST | NAVIGATION_ERROR&lt;br&gt;실패 robot 제외 → active_robot=None&lt;br&gt;다른 후보 선택 → assignment_version + 1&lt;br&gt;Target Action에서는 cancel_goal + new goal" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacing=8;" vertex="1" parent="f1"><mxGeometry x="600" y="650" width="360" height="145" as="geometry"/></mxCell>
        <mxCell id="f14" value="HMI OBSERVABILITY (전 과정 병렬)&lt;br&gt;RosBridge subscribes RobotState / EmergencyEvent / MissionStatus / images&lt;br&gt;LiveState → WebSocket SystemSnapshot (4 Hz)&lt;br&gt;Repository → SQLite append history → REST query&lt;br&gt;MockSimulator: 위 입력 포트를 동일한 domain object로 대체" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacing=10;" vertex="1" parent="f1"><mxGeometry x="180" y="880" width="1300" height="120" as="geometry"/></mxCell>
        <mxCell id="fe1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="f1" source="f2" target="f3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="fe2" value="EmergencyEvent" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="f1" source="f3" target="f4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="fe3" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="f1" source="f4" target="f5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="fe4" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="f1" source="f5" target="f6"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="fe5" value="YES" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="f1" source="f6" target="f7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="fe6" value="NO" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#b85450;" edge="1" parent="f1" source="f6" target="f8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="fe7" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="f1" source="f7" target="f9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="fe8" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="f1" source="f9" target="f10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="fe9" value="YES" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="f1" source="f10" target="f11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="fe10" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="f1" source="f11" target="f12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="fe11" value="NO" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#b85450;" edge="1" parent="f1" source="f10" target="f13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="fe12" value="retry" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#b85450;" edge="1" parent="f1" source="f13" target="f5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="fe13" value="robot recovered" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;dashed=1;strokeColor=#d79b00;" edge="1" parent="f1" source="f8" target="f5"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="ros" name="03_ROS_Node_Interfaces">
    <mxGraphModel dx="1900" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1400" math="0" shadow="0">
      <root><mxCell id="r0"/><mxCell id="r1" parent="r0"/>
        <mxCell id="rt" value="ROS 2 Node Architecture — Executable Interface Contract" style="text;html=1;fontSize=24;fontStyle=1;" vertex="1" parent="r1"><mxGeometry x="30" y="20" width="1300" height="40" as="geometry"/></mxCell>
        <mxCell id="rl" value="파랑 실선=current code　 노랑 점선=target/scaffold　 T=Topic　 S=Service　 A=Action　 QoS: state RELIABLE/volatile/depth20, image BEST_EFFORT/volatile/depth1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="r1"><mxGeometry x="30" y="70" width="1450" height="45" as="geometry"/></mxCell>
        <mxCell id="r-vision" value="&lt;b&gt;/vision_detector_{camera_id}&lt;/b&gt;&lt;br&gt;Pkg: aed_vision&lt;br&gt;Sub: image_raw/compressed&lt;br&gt;Pub: event/status/crowd/person_count/debug/heartbeat" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacing=8;" vertex="1" parent="r1"><mxGeometry x="40" y="180" width="260" height="125" as="geometry"/></mxCell>
        <mxCell id="r-event" value="T /{camera_id}/vision/emergency_event&lt;br&gt;&lt;b&gt;aed_interfaces/msg/EmergencyEvent&lt;/b&gt;&lt;br&gt;event_id:string; detected_at:Time; location:PointStamped&lt;br&gt;confidence:f32; consecutive_detections:u32; status:u8&lt;br&gt;source_id/camera_id/zone_id:string; crowd_level:u8" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacing=8;" vertex="1" parent="r1"><mxGeometry x="360" y="140" width="430" height="155" as="geometry"/></mxCell>
        <mxCell id="r-detect" value="T /{camera_id}/vision/detections (target)&lt;br&gt;&lt;b&gt;aed_interfaces/msg/DetectionSummary&lt;/b&gt;&lt;br&gt;camera_id:string; stamp:Time&lt;br&gt;person_count/fallen_count/helper_count:u32&lt;br&gt;top_fallen_confidence/top_helper_confidence:f32&lt;br&gt;fallen_location:PointStamped" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;dashed=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacing=8;" vertex="1" parent="r1"><mxGeometry x="360" y="320" width="430" height="150" as="geometry"/></mxCell>
        <mxCell id="r-crowd" value="T /{camera_id}/vision/crowd_level&lt;br&gt;&lt;b&gt;CURRENT: std_msgs/String&lt;/b&gt;&lt;br&gt;&lt;b&gt;TARGET: aed_interfaces/msg/CrowdLevel&lt;/b&gt;&lt;br&gt;camera_id/zone_id:string; stamp:Time; level:u8&lt;br&gt;person_count/threshold:u32; roi_occupancy:f32" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;dashed=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacing=8;" vertex="1" parent="r1"><mxGeometry x="360" y="495" width="430" height="145" as="geometry"/></mxCell>
        <mxCell id="r-manager" value="&lt;b&gt;/mission_manager&lt;/b&gt;&lt;br&gt;Pkg: mission_manager&lt;br&gt;Sub: event, robot_state, mission_status&lt;br&gt;Current Pub: MissionAssignment ×2&lt;br&gt;Target Client: DeliverAed ×2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacing=8;" vertex="1" parent="r1"><mxGeometry x="880" y="180" width="280" height="125" as="geometry"/></mxCell>
        <mxCell id="r-report" value="S /aed/report_emergency (target)&lt;br&gt;&lt;b&gt;aed_interfaces/srv/ReportEmergency&lt;/b&gt;&lt;br&gt;REQ location:PointStamped; source_id/zone_id:string; confidence:f32&lt;br&gt;RES accepted:bool; event_id:string; reason:string" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;dashed=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacing=8;" vertex="1" parent="r1"><mxGeometry x="850" y="340" width="360" height="135" as="geometry"/></mxCell>
        <mxCell id="r-state" value="T /aed/robot_state&lt;br&gt;&lt;b&gt;aed_interfaces/msg/RobotState&lt;/b&gt;&lt;br&gt;robot_id:string; stamp:Time; pose:PoseStamped; speed_mps:f32&lt;br&gt;battery:f32; availability/role:u8; mission_id:string; is_docked:bool&lt;br&gt;network/localization/nav2/emergency_stop/path_valid:bool&lt;br&gt;estimated_path_cost:f32; last_heartbeat:Time; detail:string" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;dashed=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacing=8;" vertex="1" parent="r1"><mxGeometry x="850" y="500" width="480" height="175" as="geometry"/></mxCell>
        <mxCell id="r-assign" value="T /{robot_id}/mission_assignment (CURRENT)&lt;br&gt;&lt;b&gt;aed_interfaces/msg/MissionAssignment&lt;/b&gt;&lt;br&gt;mission_id/event_id/robot_id:string; role:u8; target:PoseStamped&lt;br&gt;assigned_at:Time; assignment_version:u32; cancel_previous:bool" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacing=8;" vertex="1" parent="r1"><mxGeometry x="1390" y="140" width="400" height="135" as="geometry"/></mxCell>
        <mxCell id="r-deliver" value="A /{robot_id}/deliver_aed (TARGET)&lt;br&gt;&lt;b&gt;aed_interfaces/action/DeliverAed&lt;/b&gt;&lt;br&gt;GOAL mission_id/event_id:string; role:u8; target:PoseStamped; crowd:u8; requested_at:Time&lt;br&gt;RESULT outcome:u8; started/finished:Time; travelled_m:f32; final_pose; detail:string&lt;br&gt;FEEDBACK state:u8; current_pose; speed/distance_remaining/eta_seconds:f32" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;dashed=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacing=8;" vertex="1" parent="r1"><mxGeometry x="1390" y="310" width="520" height="180" as="geometry"/></mxCell>
        <mxCell id="r-executor" value="&lt;b&gt;/{robot_id}/mission_executor&lt;/b&gt;&lt;br&gt;Pkg: robot_missions ×2&lt;br&gt;Current: MissionAssignment subscriber&lt;br&gt;Nav2 ActionClient&lt;br&gt;MissionStatus publisher" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacing=8;" vertex="1" parent="r1"><mxGeometry x="1980" y="230" width="190" height="140" as="geometry"/></mxCell>
        <mxCell id="r-nav" value="A /{robot_id}/navigate_to_pose&lt;br&gt;&lt;b&gt;nav2_msgs/action/NavigateToPose&lt;/b&gt;&lt;br&gt;Goal.pose: PoseStamped&lt;br&gt;cancelable; result GoalStatus" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacing=8;" vertex="1" parent="r1"><mxGeometry x="1930" y="450" width="280" height="120" as="geometry"/></mxCell>
        <mxCell id="r-status" value="T /aed/mission_status&lt;br&gt;&lt;b&gt;aed_interfaces/msg/MissionStatus&lt;/b&gt;&lt;br&gt;mission_id/event_id/robot_id:string; assignment_version:u32&lt;br&gt;status:u8 [ASSIGNED..HELPER_ARRIVED]; stamp:Time; reason:string" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacing=8;" vertex="1" parent="r1"><mxGeometry x="1390" y="610" width="440" height="130" as="geometry"/></mxCell>
        <mxCell id="r-health" value="T /{robot_id}/sensor_health (target)&lt;br&gt;&lt;b&gt;aed_interfaces/msg/SensorHealth&lt;/b&gt;&lt;br&gt;robot_id:string; stamp:Time; lidar_status:u8&lt;br&gt;scan_age_s/valid_ratio:f32; degraded/manual_drive_active:bool; detail:string" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;dashed=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacing=8;" vertex="1" parent="r1"><mxGeometry x="850" y="760" width="440" height="135" as="geometry"/></mxCell>
        <mxCell id="r-heart" value="T /{camera_id}/vision/heartbeat&lt;br&gt;&lt;b&gt;aed_interfaces/msg/Heartbeat&lt;/b&gt;&lt;br&gt;sender_id:string; stamp:Time; sequence:u32" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacing=8;" vertex="1" parent="r1"><mxGeometry x="360" y="690" width="360" height="100" as="geometry"/></mxCell>
        <mxCell id="r-hmi" value="&lt;b&gt;/aed_hmi_bridge&lt;/b&gt; (FastAPI thread)&lt;br&gt;Sub: RobotState, MissionStatus, EmergencyEvent&lt;br&gt;Sub: person_count(UInt32), ETA result(String)&lt;br&gt;Sub: 4 × CompressedImage&lt;br&gt;Convert ROS → immutable domain models" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacing=8;" vertex="1" parent="r1"><mxGeometry x="1390" y="830" width="420" height="145" as="geometry"/></mxCell>
        <mxCell id="r-scaffold" value="TARGET NODE SET (not implemented callbacks)&lt;br&gt;/robot_state_monitor ×2 → RobotState&lt;br&gt;/sensor_health_monitor ×2 → SensorHealth + /cmd_vel fallback&lt;br&gt;/recovery_manager → Heartbeat/health → MissionStatus failure&lt;br&gt;/location_mapper → camera pixel/zone → map PointStamped&lt;br&gt;/helper_mission_controller → DetectionSummary → helper mission&lt;br&gt;/event_logger → event/status/state → persistent history" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacing=10;" vertex="1" parent="r1"><mxGeometry x="40" y="900" width="790" height="220" as="geometry"/></mxCell>
        <mxCell id="re1" value="publish" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="r1" source="r-vision" target="r-event"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="re2" value="subscribe" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="r1" source="r-event" target="r-manager"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="re3" value="current pub/sub" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="r1" source="r-manager" target="r-assign"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="re4" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="r1" source="r-assign" target="r-executor"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="re5" value="target goal/feedback/result" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;startArrow=block;dashed=1;strokeColor=#d79b00;" edge="1" parent="r1" source="r-manager" target="r-deliver"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="re6" value="current goal/result" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;startArrow=block;" edge="1" parent="r1" source="r-executor" target="r-nav"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="re7" value="publish" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="r1" source="r-executor" target="r-status"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="re8" value="subscribe / failover" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="r1" source="r-status" target="r-manager"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="re9" value="subscribe" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="r1" source="r-state" target="r-manager"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="re10" value="subscribe" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="r1" source="r-status" target="r-hmi"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="re11" value="subscribe" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="r1" source="r-state" target="r-hmi"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="re12" value="subscribe" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="r1" source="r-event" target="r-hmi"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="hmi" name="04_HMI_Data_Architecture">
    <mxGraphModel dx="1700" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1200" math="0" shadow="0">
      <root><mxCell id="h0"/><mxCell id="h1" parent="h0"/>
        <mxCell id="ht" value="AED HMI — Frontend / Backend / Data Contract" style="text;html=1;fontSize=24;fontStyle=1;" vertex="1" parent="h1"><mxGeometry x="30" y="20" width="1100" height="40" as="geometry"/></mxCell>
        <mxCell id="hros" value="ROS2 INPUT THREAD&lt;br&gt;&lt;b&gt;RosBridge&lt;/b&gt;&lt;br&gt;RobotState → RobotSnapshot&lt;br&gt;EmergencyEvent → EmergencyEventSnapshot&lt;br&gt;MissionStatus → MissionEvent&lt;br&gt;CompressedImage → JPEG bytes&lt;br&gt;UInt32 → detection count" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacing=10;" vertex="1" parent="h1"><mxGeometry x="40" y="150" width="300" height="180" as="geometry"/></mxCell>
        <mxCell id="hmock" value="MOCK INPUT THREAD&lt;br&gt;&lt;b&gt;MockSimulator + MockFrameSource&lt;/b&gt;&lt;br&gt;idle → detect → assign → drive&lt;br&gt;1/3 route failure → reassignment&lt;br&gt;Context의 동일 callback 호출" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;spacing=10;" vertex="1" parent="h1"><mxGeometry x="40" y="380" width="300" height="155" as="geometry"/></mxCell>
        <mxCell id="hcontext" value="&lt;b&gt;Context — dependency boundary&lt;/b&gt;&lt;br&gt;on_robot() → LiveState + sampled DB&lt;br&gt;on_event() → LiveState + upsert DB&lt;br&gt;on_mission() → LiveState + append DB&lt;br&gt;on_assignment() → target metadata + DB&lt;br&gt;on_frame() → FrameRegistry" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacing=10;" vertex="1" parent="h1"><mxGeometry x="430" y="220" width="330" height="210" as="geometry"/></mxCell>
        <mxCell id="hlive" value="&lt;b&gt;LiveState (thread-safe lock)&lt;/b&gt;&lt;br&gt;robots: dict[robot_id, RobotSnapshot]&lt;br&gt;active event: latest non-terminal&lt;br&gt;missions: latest transition per mission_id&lt;br&gt;mission_meta: called_at + target&lt;br&gt;stale robot after 6 s → network_ok=false&lt;br&gt;ETA from pose/speed/path_cost" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacing=10;" vertex="1" parent="h1"><mxGeometry x="850" y="120" width="360" height="215" as="geometry"/></mxCell>
        <mxCell id="hframe" value="&lt;b&gt;FrameRegistry&lt;/b&gt;&lt;br&gt;camera_open / camera_alley&lt;br&gt;robot1 / robot2&lt;br&gt;latest JPEG + fps + online&lt;br&gt;no queue backlog" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacing=10;" vertex="1" parent="h1"><mxGeometry x="850" y="390" width="250" height="145" as="geometry"/></mxCell>
        <mxCell id="hdb" value="&lt;b&gt;Repository / SQLite WAL&lt;/b&gt;&lt;br&gt;emergency_events PK event_id&lt;br&gt;mission_assignments PK mission_id+version&lt;br&gt;mission_events append-only transitions&lt;br&gt;robot_samples sampled at 1 Hz&lt;br&gt;eta_records predicted vs actual" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacing=10;" vertex="1" parent="h1"><mxGeometry x="430" y="570" width="330" height="195" as="geometry"/></mxCell>
        <mxCell id="hws" value="WS /ws/live — push every 0.25 s&lt;br&gt;&lt;b&gt;SystemSnapshot JSON&lt;/b&gt;&lt;br&gt;stamp:number(epoch s)&lt;br&gt;robots:RobotSnapshot[]; active_event:?&lt;br&gt;active_missions:MissionSummary[]&lt;br&gt;streams:StreamHealth[]; ros_connected:boolean" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacing=10;" vertex="1" parent="h1"><mxGeometry x="1300" y="100" width="410" height="175" as="geometry"/></mxCell>
        <mxCell id="hrest" value="REST JSON&lt;br&gt;GET /api/live/snapshot&lt;br&gt;GET /api/missions?limit:int[1..500]&lt;br&gt;GET /api/missions/{mission_id}:string&lt;br&gt;GET /api/stats/response-time|travel-time|eta-accuracy&lt;br&gt;GET /api/robots/{robot_id}/track?limit:int&lt;br&gt;GET /api/health" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacing=10;" vertex="1" parent="h1"><mxGeometry x="1230" y="340" width="480" height="190" as="geometry"/></mxCell>
        <mxCell id="hmjpeg" value="MJPEG&lt;br&gt;GET /api/video/{stream_id}&lt;br&gt;multipart/x-mixed-replace; JPEG frames&lt;br&gt;GET /api/video/{stream_id}/snapshot&lt;br&gt;image/jpeg" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacing=10;" vertex="1" parent="h1"><mxGeometry x="1230" y="590" width="390" height="140" as="geometry"/></mxCell>
        <mxCell id="hfront" value="REACT FRONTEND BOUNDARY" style="swimlane;html=1;rounded=1;startSize=35;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="h1"><mxGeometry x="800" y="810" width="920" height="300" as="geometry"/></mxCell>
        <mxCell id="hsocket" value="api/LiveSocket&lt;br&gt;JSON.parse → SystemSnapshot&lt;br&gt;silence timeout 6 s&lt;br&gt;reconnect 0.5→8 s backoff" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="h1"><mxGeometry x="840" y="880" width="200" height="130" as="geometry"/></mxCell>
        <mxCell id="hhook" value="useLiveSnapshot&lt;br&gt;snapshot state&lt;br&gt;connection state&lt;br&gt;receivedAt timestamp" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="h1"><mxGeometry x="1090" y="880" width="180" height="130" as="geometry"/></mxCell>
        <mxCell id="happ" value="App layout&lt;br&gt;TopBar&lt;br&gt;ActiveEvent + EtaPanel&lt;br&gt;VideoWall (4 tiles)&lt;br&gt;RobotCard × N&lt;br&gt;MissionTable (REST 5 s polling)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="h1"><mxGeometry x="1320" y="865" width="260" height="155" as="geometry"/></mxCell>
        <mxCell id="htypes" value="Type contract&lt;br&gt;backend/domain/models.py&lt;br&gt;↕ field-for-field&lt;br&gt;frontend/types/telemetry.ts&lt;br&gt;Enum u8 → readable string union" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="h1"><mxGeometry x="50" y="850" width="300" height="150" as="geometry"/></mxCell>
        <mxCell id="he1" value="real mode" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="h1" source="hros" target="hcontext"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="he2" value="--mock" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#d79b00;" edge="1" parent="h1" source="hmock" target="hcontext"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="he3" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="h1" source="hcontext" target="hlive"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="he4" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="h1" source="hcontext" target="hframe"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="he5" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="h1" source="hcontext" target="hdb"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="he6" value="Hub serialize" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="h1" source="hlive" target="hws"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="he7" value="query" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="h1" source="hdb" target="hrest"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="he8" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="h1" source="hframe" target="hmjpeg"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="he9" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="h1" source="hws" target="hsocket"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="he10" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="h1" source="hsocket" target="hhook"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="he11" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="h1" source="hhook" target="happ"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="he12" value="fetch" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="h1" source="hrest" target="happ"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="he13" value="img src" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="h1" source="hmjpeg" target="happ"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="current-detail" name="05_CURRENT_Rqt_Detail">
    <mxGraphModel dx="1800" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="2400" math="0" shadow="0">
      <root><mxCell id="c0"/><mxCell id="c1" parent="c0"/>
        <mxCell id="ct" value="CURRENT CODE — rqt_graph Line-Level Communication Specification" style="text;html=1;fontSize=26;fontStyle=1;" vertex="1" parent="c1"><mxGeometry x="40" y="20" width="1500" height="45" as="geometry"/></mxCell>
        <mxCell id="cl" value="각 행은 독립된 통신선입니다. 왼쪽 Publisher → 가운데 Interface Contract → 오른쪽 Subscriber. 선 교차 없음. QoS와 발행 조건은 실제 코드 기준." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacing=10;fontSize=14;" vertex="1" parent="c1"><mxGeometry x="40" y="75" width="1960" height="55" as="geometry"/></mxCell>
        <mxCell id="ch1" value="PUBLISHER NODE" style="text;html=1;fontSize=16;fontStyle=1;align=center;" vertex="1" parent="c1"><mxGeometry x="50" y="145" width="280" height="30" as="geometry"/></mxCell><mxCell id="ch2" value="TOPIC / ACTION + TYPE + PAYLOAD + QoS + CONDITION" style="text;html=1;fontSize=16;fontStyle=1;align=center;" vertex="1" parent="c1"><mxGeometry x="390" y="145" width="1050" height="30" as="geometry"/></mxCell><mxCell id="ch3" value="SUBSCRIBER NODE / CALLBACK" style="text;html=1;fontSize=16;fontStyle=1;align=center;" vertex="1" parent="c1"><mxGeometry x="1510" y="145" width="440" height="30" as="geometry"/></mxCell>
        <mxCell id="cp1" value="/{camera_id}/vision_detector&lt;br&gt;camera_open 또는 camera_alley&lt;br&gt;_publish_emergency_event()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="c1"><mxGeometry x="50" y="210" width="280" height="105" as="geometry"/></mxCell>
        <mxCell id="ci1" value="&lt;b&gt;T /{camera_id}/vision/emergency_event&lt;/b&gt;&lt;br&gt;Type: aed_interfaces/msg/EmergencyEvent&lt;br&gt;Payload: event_id:string; detected_at:Time; location:PointStamped(map); confidence:float32; consecutive_detections:uint32; status:uint8; source_id:string; camera_id:string; zone_id:string; crowd_level:uint8&lt;br&gt;QoS CURRENT: depth=10, RELIABLE, VOLATILE　|　Publish: 연속 fallen 검출이 confirmation 조건을 만족하거나 상태가 변할 때" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacing=10;fontSize=13;" vertex="1" parent="c1"><mxGeometry x="390" y="190" width="1050" height="145" as="geometry"/></mxCell>
        <mxCell id="cs1" value="/aed_hmi_bridge&lt;br&gt;_handle_emergency_event()&lt;br&gt;→ EmergencyEventSnapshot&lt;br&gt;&lt;br&gt;주의: /mission_manager는 /aed/emergency_event만 구독하므로 현재 직접 연결 안 됨" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacing=8;" vertex="1" parent="c1"><mxGeometry x="1510" y="195" width="440" height="135" as="geometry"/></mxCell>
        <mxCell id="cp2" value="/{camera_id}/vision_detector&lt;br&gt;_process_frame()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="c1"><mxGeometry x="50" y="390" width="280" height="90" as="geometry"/></mxCell>
        <mxCell id="ci2" value="&lt;b&gt;T /{camera_id}/vision/person_count&lt;/b&gt;&lt;br&gt;Type: std_msgs/msg/UInt32　|　Payload: data:uint32 = 현재 프레임의 person class 검출 개수&lt;br&gt;QoS CURRENT: depth=10, RELIABLE, VOLATILE　|　Publish: 처리한 매 프레임&lt;br&gt;Consumer mapping: camera_id → stream_id, 최근 3초 값만 HMI detection badge에 유지" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacing=10;fontSize=13;" vertex="1" parent="c1"><mxGeometry x="390" y="365" width="1050" height="125" as="geometry"/></mxCell>
        <mxCell id="cs2" value="/aed_hmi_bridge&lt;br&gt;lambda → Context.on_person_count()&lt;br&gt;→ LiveState._detections[camera_id]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="c1"><mxGeometry x="1510" y="380" width="440" height="95" as="geometry"/></mxCell>
        <mxCell id="cp3" value="/{camera_id}/vision_detector&lt;br&gt;_publish_debug_frame()&lt;br&gt;&lt;br&gt;/robot{1,2}/oakd driver" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="c1"><mxGeometry x="50" y="555" width="280" height="115" as="geometry"/></mxCell>
        <mxCell id="ci3" value="&lt;b&gt;T camera video streams ×4&lt;/b&gt;&lt;br&gt;/camera_open/vision/debug/compressed; /camera_alley/vision/debug/compressed; /robot1/oakd/rgb/image_raw/compressed; /robot2/oakd/rgb/image_raw/compressed&lt;br&gt;Type: sensor_msgs/msg/CompressedImage　|　Payload: header.stamp:Time; header.frame_id:string; format:string('jpeg'); data:uint8[] JPEG&lt;br&gt;QoS IMAGE: KEEP_LAST depth=1, BEST_EFFORT, VOLATILE　|　Publish: frame available; newest frame only" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacing=10;fontSize=13;" vertex="1" parent="c1"><mxGeometry x="390" y="535" width="1050" height="150" as="geometry"/></mxCell>
        <mxCell id="cs3" value="/aed_hmi_bridge ×4 subscriptions&lt;br&gt;lambda → Context.on_frame(stream_id, bytes)&lt;br&gt;→ FrameRegistry latest JPEG&lt;br&gt;→ GET /api/video/{stream_id} MJPEG" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="c1"><mxGeometry x="1510" y="555" width="440" height="115" as="geometry"/></mxCell>
        <mxCell id="cp4" value="/{camera_id}/vision_detector&lt;br&gt;1.0 s timer&lt;br&gt;_publish_heartbeat()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="c1"><mxGeometry x="50" y="740" width="280" height="95" as="geometry"/></mxCell>
        <mxCell id="ci4" value="&lt;b&gt;T /{camera_id}/vision/heartbeat&lt;/b&gt;&lt;br&gt;Type: aed_interfaces/msg/Heartbeat　|　Payload: sender_id:string='aed_vision:{camera_id}'; stamp:Time; sequence:uint32 monotonic&lt;br&gt;QoS CURRENT: depth=10, RELIABLE, VOLATILE　|　Publish period: 1.0 s regardless of image availability&lt;br&gt;CURRENT consumer: 없음　|　TARGET consumer: /recovery_manager timeout watchdog" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacing=10;fontSize=13;" vertex="1" parent="c1"><mxGeometry x="390" y="720" width="1050" height="130" as="geometry"/></mxCell>
        <mxCell id="cs4" value="현재 subscriber 없음&lt;br&gt;/recovery_manager scaffold&lt;br&gt;&lt;br&gt;설계 필요: timeout_s, recovery status 출력" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="c1"><mxGeometry x="1510" y="735" width="440" height="105" as="geometry"/></mxCell>
        <mxCell id="cp5" value="/robot_state_monitor ×2&lt;br&gt;CURRENT: scaffold&lt;br&gt;필요 producer 미구현" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;" vertex="1" parent="c1"><mxGeometry x="50" y="915" width="280" height="100" as="geometry"/></mxCell>
        <mxCell id="ci5" value="&lt;b&gt;T /aed/robot_state&lt;/b&gt;&lt;br&gt;Type: aed_interfaces/msg/RobotState&lt;br&gt;Payload: robot_id:string; stamp:Time; pose:PoseStamped; speed_mps:float32; battery_percentage:float32; availability:uint8; role:uint8; mission_id:string; is_docked:bool; network_ok/localization_ok/nav2_ok/emergency_stop/path_valid:bool; estimated_path_cost:float32; last_heartbeat:Time; detail:string&lt;br&gt;QoS consumers: RELIABLE, VOLATILE, KEEP_LAST depth=20　|　Expected publish: periodic state (권장 5–10 Hz)" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacing=10;fontSize=13;" vertex="1" parent="c1"><mxGeometry x="390" y="885" width="1050" height="165" as="geometry"/></mxCell>
        <mxCell id="cs5" value="Subscriber A: /mission_manager&lt;br&gt;_on_robot_state() → candidate cache/rank&lt;br&gt;&lt;br&gt;Subscriber B: /aed_hmi_bridge&lt;br&gt;→ RobotSnapshot + LiveState + DB 1 Hz sample" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacing=8;" vertex="1" parent="c1"><mxGeometry x="1510" y="905" width="440" height="130" as="geometry"/></mxCell>
        <mxCell id="cp6" value="External aggregator / reporter&lt;br&gt;CURRENT missing bridge&lt;br&gt;vision camera topics → aggregate" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;" vertex="1" parent="c1"><mxGeometry x="50" y="1100" width="280" height="105" as="geometry"/></mxCell>
        <mxCell id="ci6" value="&lt;b&gt;T /aed/emergency_event&lt;/b&gt;&lt;br&gt;Type: aed_interfaces/msg/EmergencyEvent (fields same as row 1)&lt;br&gt;QoS consumers: RELIABLE, VOLATILE; mission_manager depth=10, HMI depth=20&lt;br&gt;Consume condition: mission_manager accepts only status==CONFIRMED, nonempty event_id, new event_id, nonempty location.header.frame_id&lt;br&gt;&lt;b&gt;GAP: vision_detector publishes per-camera topic, but no node currently republishes to this aggregate topic.&lt;/b&gt;" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacing=10;fontSize=13;" vertex="1" parent="c1"><mxGeometry x="390" y="1075" width="1050" height="150" as="geometry"/></mxCell>
        <mxCell id="cs6" value="Subscriber A: /mission_manager&lt;br&gt;_on_emergency() → event context → _assign_next()&lt;br&gt;&lt;br&gt;Subscriber B: /aed_hmi_bridge&lt;br&gt;→ active event + DB upsert" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacing=8;" vertex="1" parent="c1"><mxGeometry x="1510" y="1090" width="440" height="125" as="geometry"/></mxCell>
        <mxCell id="cp7" value="/mission_manager&lt;br&gt;_assign_next()&lt;br&gt;publisher selected by robot_id" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="c1"><mxGeometry x="50" y="1285" width="280" height="95" as="geometry"/></mxCell>
        <mxCell id="ci7" value="&lt;b&gt;T /{robot_id}/mission_assignment&lt;/b&gt; (robot1, robot2)&lt;br&gt;Type: aed_interfaces/msg/MissionAssignment&lt;br&gt;Payload: mission_id:string='{event_id}-aed'; event_id:string; robot_id:string; role:uint8=ROLE_AED_DELIVERY; target:PoseStamped(map); assigned_at:Time; assignment_version:uint32 incrementing; cancel_previous:bool=true&lt;br&gt;QoS: depth=10, RELIABLE, VOLATILE　|　Publish: candidate selected or robot recovered; exactly one selected robot topic" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacing=10;fontSize=13;" vertex="1" parent="c1"><mxGeometry x="390" y="1250" width="1050" height="165" as="geometry"/></mxCell>
        <mxCell id="cs7" value="/{robot_id}/mission_executor&lt;br&gt;_on_assignment()&lt;br&gt;robot_id/mission_id validation&lt;br&gt;cancel_previous → old goal cancel&lt;br&gt;→ NavigateToPose goal" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacing=8;" vertex="1" parent="c1"><mxGeometry x="1510" y="1270" width="440" height="125" as="geometry"/></mxCell>
        <mxCell id="cp8" value="/{robot_id}/mission_executor&lt;br&gt;ActionClient.send_goal_async()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="c1"><mxGeometry x="50" y="1480" width="280" height="90" as="geometry"/></mxCell>
        <mxCell id="ci8" value="&lt;b&gt;A /{robot_id}/navigate_to_pose&lt;/b&gt;&lt;br&gt;Type: nav2_msgs/action/NavigateToPose&lt;br&gt;Goal: pose:geometry_msgs/PoseStamped (target stamp overwritten with now)&lt;br&gt;Result consumed: action GoalStatus → SUCCEEDED=ARRIVED; CANCELED=CANCELED; else=NAVIGATION_ERROR&lt;br&gt;Feedback: current code does not consume feedback　|　Precondition: action server available within 1.0 s, target.frame_id nonempty" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacing=10;fontSize=13;" vertex="1" parent="c1"><mxGeometry x="390" y="1450" width="1050" height="150" as="geometry"/></mxCell>
        <mxCell id="cs8" value="/{robot_id}/bt_navigator&lt;br&gt;Nav2 NavigateToPose ActionServer&lt;br&gt;→ planner/controller stack&lt;br&gt;→ Create3 cmd_vel" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="c1"><mxGeometry x="1510" y="1470" width="440" height="110" as="geometry"/></mxCell>
        <mxCell id="cp9" value="/{robot_id}/mission_executor&lt;br&gt;_publish_status()&lt;br&gt;및 /mission_manager recovery status" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="c1"><mxGeometry x="50" y="1665" width="280" height="105" as="geometry"/></mxCell>
        <mxCell id="ci9" value="&lt;b&gt;T /aed/mission_status&lt;/b&gt;&lt;br&gt;Type: aed_interfaces/msg/MissionStatus&lt;br&gt;Payload: mission_id/event_id/robot_id:string; assignment_version:uint32; status:uint8 {ASSIGNED, DISPATCHING, EN_ROUTE, ARRIVED, COMPLETED, CANCELED, BLOCKED, NETWORK_LOST, NAVIGATION_ERROR, RECOVERY_WAIT, RECOVERY_RESUMED, HELPER_*}; stamp:Time; reason:string&lt;br&gt;QoS: publisher depth=10 or 20; consumers RELIABLE VOLATILE depth=20　|　Publish: every state transition/failure" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacing=10;fontSize=13;" vertex="1" parent="c1"><mxGeometry x="390" y="1630" width="1050" height="175" as="geometry"/></mxCell>
        <mxCell id="cs9" value="Subscriber A: /mission_manager&lt;br&gt;match event_id + active_robot + version&lt;br&gt;ARRIVED/COMPLETED terminal; failure → reassign&lt;br&gt;&lt;br&gt;Subscriber B: /aed_hmi_bridge&lt;br&gt;LiveState + append mission_events" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacing=8;" vertex="1" parent="c1"><mxGeometry x="1510" y="1650" width="440" height="140" as="geometry"/></mxCell>
        <mxCell id="cp10" value="multi_robot_emergency&lt;br&gt;external/current publisher" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;" vertex="1" parent="c1"><mxGeometry x="50" y="1870" width="280" height="85" as="geometry"/></mxCell>
        <mxCell id="ci10" value="&lt;b&gt;T /emergency/eta/result&lt;/b&gt;&lt;br&gt;Type: std_msgs/msg/String containing JSON&lt;br&gt;Required JSON keys/types: request_id:string; robot_id:string; predicted_sec:number; actual_sec:number; error_sec:number; status:string; stamp:number(epoch s)&lt;br&gt;QoS LATCHED: KEEP_LAST depth=10, RELIABLE, TRANSIENT_LOCAL　|　Invalid JSON/schema: log and discard; valid → eta_records upsert" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacing=10;fontSize=13;" vertex="1" parent="c1"><mxGeometry x="390" y="1840" width="1050" height="145" as="geometry"/></mxCell>
        <mxCell id="cs10" value="/aed_hmi_bridge&lt;br&gt;_handle_eta_result()&lt;br&gt;→ EtaRecord.from_json() validation&lt;br&gt;→ Repository.upsert_eta_record()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="c1"><mxGeometry x="1510" y="1860" width="440" height="105" as="geometry"/></mxCell>
        <mxCell id="ce1a" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;exitX=1;exitY=.5;entryX=0;entryY=.5;" edge="1" parent="c1" source="cp1" target="ci1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ce1b" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;exitX=1;exitY=.5;entryX=0;entryY=.5;" edge="1" parent="c1" source="ci1" target="cs1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ce2a" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="c1" source="cp2" target="ci2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ce2b" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="c1" source="ci2" target="cs2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ce3a" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="c1" source="cp3" target="ci3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ce3b" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="c1" source="ci3" target="cs3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ce4a" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="c1" source="cp4" target="ci4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ce4b" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;dashed=1;strokeColor=#d79b00;" edge="1" parent="c1" source="ci4" target="cs4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ce5a" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;dashed=1;strokeColor=#d79b00;" edge="1" parent="c1" source="cp5" target="ci5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ce5b" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="c1" source="ci5" target="cs5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ce6a" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;dashed=1;strokeColor=#b85450;" edge="1" parent="c1" source="cp6" target="ci6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ce6b" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="c1" source="ci6" target="cs6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ce7a" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="c1" source="cp7" target="ci7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ce7b" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="c1" source="ci7" target="cs7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ce8a" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="c1" source="cp8" target="ci8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ce8b" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;startArrow=block;startFill=1;" edge="1" parent="c1" source="ci8" target="cs8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ce9a" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="c1" source="cp9" target="ci9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ce9b" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="c1" source="ci9" target="cs9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ce10a" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="c1" source="cp10" target="ci10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ce10b" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="c1" source="ci10" target="cs10"><mxGeometry relative="1" as="geometry"/></mxCell>
