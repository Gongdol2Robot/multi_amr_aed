<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>aed_hmi</name>
  <version>0.1.0</version>
  <description>Operator HMI bridge for Multi-AMR AED status and controls.</description>
  <maintainer email="team@example.com">multi_amr_aed team</maintainer>
  <license>Apache-2.0</license>

  <depend>aed_interfaces</depend>
  <depend>rclpy</depend>
  <exec_depend>robot_state_monitor</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>

  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
