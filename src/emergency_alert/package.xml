<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>emergency_alert</name>
  <version>0.2.0</version>
  <description>Mission-aware emergency audio alerts for TurtleBot4.</description>
  <maintainer email="team@example.com">multi_amr_aed team</maintainer>
  <license>Apache-2.0</license>

  <depend>action_msgs</depend>
  <depend>aed_interfaces</depend>
  <depend>irobot_create_msgs</depend>
  <depend>launch</depend>
  <depend>launch_ros</depend>
  <depend>nav2_msgs</depend>
  <depend>rclpy</depend>
  <depend>std_msgs</depend>

  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
