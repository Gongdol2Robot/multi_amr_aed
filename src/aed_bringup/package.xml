<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>aed_bringup</name>
  <version>0.1.0</version>
  <description>Bringup and Nav2 configuration for the Multi-AMR AED system.</description>
  <maintainer email="team@example.com">multi_amr_aed team</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>nav2_bringup</exec_depend>
  <exec_depend>nav2_regulated_pure_pursuit_controller</exec_depend>
  <exec_depend>mission_manager</exec_depend>
  <exec_depend>robot_state_monitor</exec_depend>
  <exec_depend>turtlebot4_navigation</exec_depend>
  <exec_depend>aed_hmi</exec_depend>
  <exec_depend>aed_vision</exec_depend>
  <exec_depend>emergency_alert</exec_depend>
  <exec_depend>multi_robot_emergency</exec_depend>
  <exec_depend>sensor_recovery</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
