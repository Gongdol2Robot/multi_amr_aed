# HMI. node_modules 는 68MB 가 넘고 package-lock.json 으로 복원된다.
# var/ 는 관제 서버가 만드는 SQLite 파일이라 환경마다 다르다.
node_modules/
src/aed_hmi/frontend/dist/
src/aed_hmi/var/
var/

# Runtime output
bags/
captures/
# tools/survey 의 측량 사진은 제외하지 않는다. 호모그래피를 다시 계산하거나
# 왜 그 값이 나왔는지 확인할 때 필요한 근거 자료이고, 장당 60KB 수준이다.
data/
datasets/
hard_negatives/
runs/
finetune_runs/
test_captures/
*.db
*.sqlite
*.sqlite3

# slam_toolbox 직렬화 결과. 스캔을 통째로 담아 수백 MB가 나온다.
# 지도 자체는 map.pgm/map.yaml로 충분하고, posegraph는 이어서 매핑할
# 사람만 로컬에 두면 된다.
maps/*.posegraph
maps/*.data

# Large/generated ML artifacts
models/*.engine
models/*.onnx
models/*.pt
models/*.pth
vision_training/models/*.pt

# Keep directory placeholders
!models/.gitkeep

# TypeScript 증분 빌드 캐시
*.tsbuildinfo

# Vite 개발 캐시
